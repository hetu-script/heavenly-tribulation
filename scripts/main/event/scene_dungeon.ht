function createSceneDungeonRun({routeId}) {
  final previous = game.flags.dungeon
  final rank = hero.rank
  final level = previous?.mode == 'scene_chain' ? (previous.level ?? 0) : 0
  game.flags.dungeon = {
    seed: random.nextInt(0x7fffffff),
    mode: 'scene_chain',
    rank: rank,
    level: level,
    levelMax: rank * 2 + 1,
    routeId: routeId,
    currentSceneIndex: 0,
    rooms: {},
    active: true,
    battleResult: null,
    battleRoomIndex: null,
  }
  hero.dungeonId = 'scene_chain'
  return game.flags.dungeon
}

function createSceneDungeonRoom(scene, run) {
  final room = {
    sceneId: scene.id,
    actor: null,
    enemy: null,
    battleWon: false,
    rewards: null,
    rewardGranted: false,
    scavengeCandidates: null,
    scavengeResolved: false,
    actionUses: {},
  }
  if (scene.kind == 'battle' || scene.kind == 'elite' || scene.kind == 'boss') {
    final enemyData = scene.enemy
    final actor = BattleEntity(
      id: '${scene.id}_${crypto.randomUID(withTime: true)}',
      name: engine.locale(enemyData.name),
      rank: run.rank,
      level: minLevelForRank(run.rank) + run.level + enemyData.levelBonus,
      cultivationFavor: enemyData.genre,
      autoGenerateDeck: false,
    )
    actor.isElite = enemyData.isElite ?? false
    generateBattleDeck(actor)
    room.actor = actor
    room.enemy = actor
  } else if (scene.kind == 'merchant') {
    final merchantData = scene.merchant
    final kind = random.nextIterable(merchantData.kinds)
    let categories
    switch (kind) {
      'smith': {
        categories = ['weapon', 'armor']
      }
      'enchanter': {
        categories = ['jewelry', 'talisman']
      }
      'pharmacist': {
        categories = ['potion']
      }
      'bookDealer': {
        categories = ['cardpack']
      }
      default: {
        throw 'Unknown scene merchant kind: ${kind}'
      }
    }
    final actor = BattleEntity(
      id: '${scene.id}_${crypto.randomUID(withTime: true)}',
      name: engine.locale(kind),
      icon: 'illustration/avatar/npc/trader.png',
      rank: run.rank,
      level: minLevelForRank(run.rank),
      allocateSkills: false,
      autoGenerateDeck: false,
    )
    actor.merchantKind = kind
    entityCollect(actor, 'money', 500000)
    characterInitItems(actor, categories, merchantData.itemCount, isIdentified: true)
    room.actor = actor
  } else if (scene.kind == 'rest') {
    final actorData = scene.actor
    room.actor = BattleEntity(
      id: '${scene.id}_${crypto.randomUID(withTime: true)}',
      name: engine.locale(actorData.name),
      icon: actorData.icon,
      rank: run.rank,
      level: minLevelForRank(run.rank),
      allocateSkills: false,
      autoGenerateDeck: false,
    )
  } else {
    throw 'Unknown scene dungeon room kind: ${scene.kind}'
  }
  return room
}

function createSceneDungeonRewards(room, scene) {
  room.rewards ??= createReward(
    entity: room.enemy,
    isIdentified: room.enemy.rank < 1,
    details: scene.reward,
  )
  return room.rewards
}

function useSceneDungeonRest(room, action) {
  assert(action.kind == 'restore')
  if (room.actionUses[action.id] == true) return false
  room.actionUses[action.id] = true
  Player.restoreLife((hero.stats.lifeMax * action.amount).round())
  return true
}

function clearSceneDungeonBattleResult() {
  game.flags.dungeon.battleResult = null
  game.flags.dungeon.battleRoomIndex = null
}

function leaveSceneDungeonAfterFailure() {
  clearSceneDungeonBattleResult()
  game.flags.dungeon.active = false
  hero.dungeonId = null
}
