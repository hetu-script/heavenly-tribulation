function createSceneDungeonRun({routeId}) {
  final previous = game.flags.dungeon
  final rank = hero.rank
  final level = previous?.mode == 'scene_chain' ? (previous.level ?? 0) : 0
  game.flags.dungeon = {
    seed: random.nextInt(0x7fffffff),
    mode: 'scene_chain',
    rank: rank,
    level: level,
    levelMax: rank * 2 + 1,
    routeId: routeId,
    currentSceneIndex: 0,
    rooms: {},
    active: true,
    battleResult: null,
    battleRoomIndex: null,
  }
  hero.dungeonId = 'scene_chain'
  return game.flags.dungeon
}

function createSceneDungeonRoom(scene, run) {
  final room = {
    sceneId: scene.id,
    actor: null,
    enemy: null,
    battleWon: false,
    rewards: null,
    rewardGranted: false,
    scavengeCandidates: null,
    scavengeResolved: false,
    actionUses: {},
  }
  if (scene.kind == 'battle' || scene.kind == 'elite' || scene.kind == 'boss') {
    final enemyData = scene.enemy
    final actor = BattleEntity(
      id: '${scene.id}_${crypto.randomUID(withTime: true)}',
      name: engine.locale(enemyData.name),
      rank: run.rank,
      level: minLevelForRank(run.rank) + run.level + enemyData.levelBonus,
      cultivationFavor: enemyData.genre,
      autoGenerateDeck: false,
    )
    actor.isElite = enemyData.isElite ?? false
    generateBattleDeck(actor)
    room.actor = actor
    room.enemy = actor
  } else if (scene.kind == 'merchant') {
    final merchantData = scene.merchant
    final kind = random.nextIterable(merchantData.kinds)
    let categories
    switch (kind) {
      'smith': {
        categories = ['weapon', 'armor']
      }
      'enchanter': {
        categories = ['jewelry', 'talisman']
      }
      'pharmacist': {
        categories = ['potion']
      }
      'bookDealer': {
        categories = ['cardpack']
      }
      default: {
        throw 'Unknown scene merchant kind: ${kind}'
      }
    }
    final actor = BattleEntity(
      id: '${scene.id}_${crypto.randomUID(withTime: true)}',
      name: engine.locale(kind),
      icon: 'illustration/avatar/npc/trader.png',
      rank: run.rank,
      level: minLevelForRank(run.rank),
      allocateSkills: false,
      autoGenerateDeck: false,
    )
    actor.merchantKind = kind
    entityCollect(actor, 'money', 500000)
    characterInitItems(actor, categories, merchantData.itemCount, isIdentified: true)
    room.actor = actor
  } else if (scene.kind == 'rest') {
    final actorData = scene.actor
    room.actor = BattleEntity(
      id: '${scene.id}_${crypto.randomUID(withTime: true)}',
      name: engine.locale(actorData.name),
      icon: actorData.icon,
      rank: run.rank,
      level: minLevelForRank(run.rank),
      allocateSkills: false,
      autoGenerateDeck: false,
    )
  } else {
    throw 'Unknown scene dungeon room kind: ${scene.kind}'
  }
  return room
}

function createSceneDungeonRewards(room, scene) {
  room.rewards ??= createReward(
    entity: room.enemy,
    isIdentified: room.enemy.rank < 1,
    details: scene.reward,
  )
  return room.rewards
}

function useSceneDungeonRest(room, action) {
  assert(action.kind == 'restore')
  if (room.actionUses[action.id] == true) return false
  room.actionUses[action.id] = true
  Player.restoreLife((hero.stats.lifeMax * action.amount).round())
  return true
}

function clearSceneDungeonBattleResult() {
  delete game.flags.dungeon['battleResult']
  delete game.flags.dungeon['battleRoomIndex']
}

/// 统一跨轮结算：胜利、失败与主动放弃共用，active 保证幂等。
/// 返回本次结算摘要；已结算或不存在进行中的秘境时返回 null。
function settleSceneDungeonRun({outcome}) {
  assert(outcome == 'victory' || outcome == 'failure' || outcome == 'abandon')
  final run = game.flags.dungeon
  if (run == null || run.active != true) return null

  final previousLevel = run.level ?? 0
  final dungeonCardIds = []
  for (final card in hero.cardLibrary.values) {
    if (card.isDungeonCard == true) {
      dungeonCardIds.add(card.id)
    }
  }

  final deckIndex = hero.battleDeckIndex
  if (deckIndex >= 0 && deckIndex < hero.battleDecks.length) {
    final cards = hero.battleDecks[deckIndex].cards
    cards.removeWhere((cardId) => dungeonCardIds.contains(cardId))
  }
  for (final cardId in dungeonCardIds) {
    delete hero.cardLibrary[cardId]
  }

  var removedInventoryItemCount = 0
  var clearedMaterialKinds = 0
  if (outcome != 'victory') {
    final equippedItemIds = Set()
    for (final itemId in hero.equipments.values) {
      if (itemId != null) equippedItemIds.add(itemId)
    }
    for (final itemId in hero.inventory.keys.toList()) {
      if (!equippedItemIds.contains(itemId)) {
        delete hero.inventory[itemId]
        removedInventoryItemCount += 1
      }
    }
    clearedMaterialKinds = hero.materials.keys.length
    hero.materials.clear()
  }

  if (outcome == 'victory') {
    final levelMax = run.levelMax ?? run.rank * 2 + 1
    run.level = Math.min(previousLevel + 1, levelMax)
  } else {
    run.level = 0
  }

  run.rooms.clear()
  run.currentSceneIndex = 0
  clearSceneDungeonBattleResult()
  run.active = false
  delete hero['dungeonId']

  return {
    outcome: outcome,
    previousLevel: previousLevel,
    level: run.level,
    removedDungeonCardCount: dungeonCardIds.length,
    removedInventoryItemCount: removedInventoryItemCount,
    clearedMaterialKinds: clearedMaterialKinds,
  }
}
