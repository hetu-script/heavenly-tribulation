
struct Equipment {
  constructor ({
    id,
    name,
    icon,
    flavortext,
    category,
    kind,
    rarity,
    rank,
    level,
    affixes,
    isIdentified = true,
  }) {
    this.id = id ?? crypto.randomUID(withTime: true)
    this.entityType = kEntityTypeItem
    this.createdTimestamp = game.timestamp
    this.isIdentified = isIdentified
    this.isEquippable = true
    this.type = 'equipment'

    // kind 决定了物品名字的生成方式
    // weapon具体分为: sabre, sword, spear, staff, bow, dart, music
    // talisman具体分为: buff, ongoing, consume
    // 其他情况下 kind == type
    this.kind = kind
    // category 决定了能装备的数量
    // weapon, armor, helmet, boots, vehicle，talisman
    this.category = category
    if (category == null) {
      if (this.kind != null) {
        final categories = [...Constants.equipmentCategoryKinds.keys]
        this.category = categories.firstWhere((key) {
          return Constants.equipmentCategoryKinds[key].contains(this.kind)
        })
      } else {
        this.category = random.nextIterable(Constants.equipmentCategoryKinds.keys)
        this.kind = random.nextIterable(Constants.equipmentCategoryKinds[this.category])
      }
    }
    assert(Constants.equipmentCategoryKinds.containsKey(this.category))
    if (this.kind == null) {
      this.kind = random.nextIterable(Constants.equipmentCategoryKinds[this.category])
    }
    assert(Constants.equipmentKinds.contains(this.kind))
    this.name = name ?? generateTalismanName(kind: this.kind)

    if (rarity != null) {
      assert(kRarity.containsKey(rarity))
      this.rarity = rarity
      this.rank = kRarity[rarity].rank
    } else if (rank != null) {
      assert(rank >= 0 && rank <= kCultivationRankMax)
      this.rank = rank
      this.rarity = Constants.rankToRarity[rank]
    } else {
      this.rank = 0
      this.rarity = kRarityCommon
    }
    this.icon = icon ?? 'item/equipment/${this.kind}.png'

    final minLevel = minLevelForRank(this.rank)
    final maxLevel = maxLevelForRank(this.rank)
    level ??= getRandomLevel(minLevel, maxLevel)
    // 这里要再判断一次，因为可能是从外部传入的 level
    this.level = level.clamp(Math.max(1, minLevel), maxLevel)
    this.attributes = calculateEquipmentAttributeRequirements(this.kind, this.level)

    this.affixes = []
    this.affixUniqueIds = Set()
    final providedAffixUniqueIds = Set()
    if (affixes != null) {
      for (final affixData in affixes) {
        let uniqueIds
        if (affixData.uniqueIds is List) {
          uniqueIds = affixData.uniqueIds
        } else {
          uniqueIds = [affixData.uniqueId ?? affixData.id]
        }
        for (final uniqueId in uniqueIds) {
          if (providedAffixUniqueIds.contains(uniqueId)) {
            throw('Duplicate affix for target equipment: ${affixData.id}')
          }
          providedAffixUniqueIds.add(uniqueId)
        }
      }
    }
    let mainAffix
    final mainAffixes = game.passives.values.where((affix) {
      if (!affix.isEquipmentMain) return false
      if (affix.kinds is List && !affix.kinds.contains(this.kind)) return false
      if ((affix.rank ?? 0) > this.rank) return false
      if (providedAffixUniqueIds.contains(affix.id) ||
        (affix.uniqueId != null && providedAffixUniqueIds.contains(affix.uniqueId))) return false
      if (affix.uniqueIds is List) {
        for (final uniqueId in affix.uniqueIds) {
          if (providedAffixUniqueIds.contains(uniqueId)) return false
        }
      }
      return true
    })
    if (mainAffixes.isEmpty) {
      throw('Found no main affix for item: category: ${this.category}, kind: ${this.kind}, rank: ${this.rank}')
    }

    mainAffix = Object.create(random.nextIterable(mainAffixes))
    if (mainAffix.increment != null) {
      mainAffix.level = Math.max(this.level, getPassiveAffixMinLevel(mainAffix))
      mainAffix.value = calculatePassiveAffixValue(mainAffix, level: mainAffix.level)
    }
    this.affixes.add(mainAffix)
    if (mainAffix.uniqueIds is List) {
      this.affixUniqueIds.addAll(mainAffix.uniqueIds)
    } else {
      this.affixUniqueIds.add(mainAffix.uniqueId ?? mainAffix.id)
    }
    
    // 具体装备种类的风味文本优先，未配置时使用装备类别文本
    let flavortextId = 'flavortext_${this.category}'
    final kindFlavortextId = 'flavortext_${this.kind}'
    if (engine.hasLocaleKey(kindFlavortextId)) flavortextId = kindFlavortextId
    this.flavortext = flavortext ?? engine.locale(flavortextId)

    if (affixes == null) {
      // 根据境界，生成额外词条
      final affixCountInfo = getMinMaxExtraAffixCount(this.rank)
      let affixCount = affixCountInfo.minExtra
      if (affixCountInfo.maxExtra > 0) {
        if (affixCount < affixCountInfo.maxExtra) {
          affixCount += random.nextInt(affixCountInfo.maxExtra - affixCount + 1)
        }
      }
      if (affixCount > 0) {
        for (var i in range(affixCount)) {
          final supportAffixes = game.passives.values.where((affix) {
            if (!affix.isEquipmentExtraAffix) return false
            if (this.affixUniqueIds.contains(affix.id) ||
              (affix.uniqueId != null && this.affixUniqueIds.contains(affix.uniqueId))) return false
            if (affix.kinds is List && !affix.kinds.contains(this.kind)) return false
            if ((affix.rank ?? 0) > this.rank) return false
            return true
          })
          if (supportAffixes.isEmpty) {
            engine.error('Found no support affix for item: category: ${this.category}, kind: ${this.kind}')
            break
          } else {
            final affix = Object.create(random.nextIterable(supportAffixes))
            if (affix.increment != null) {
              affix.level = rollPassiveAffixLevel(affix, maxLevel: this.level)
              affix.value = calculatePassiveAffixValue(affix, level: affix.level)
            }
            this.affixes.add(affix)
            this.affixUniqueIds.add(affix.uniqueId ?? affix.id)
          }
          
        }
      }
    } else {
      final countInfo = getMinMaxExtraAffixCount(this.rank)
      for (final affixData in affixes) {
        final affix = Object.create(affixData)
        if (affix.kinds is List && !affix.kinds.contains(this.kind)) {
          throw('Affix ${affix.id} is incompatible with equipment kind: ${this.kind}')
        }
        final sourceRank = affix.sourceRank
        if (sourceRank != null && sourceRank > this.rank) {
          throw('Extracted affix source rank exceeds target equipment rank: ${affix.id}')
        }
        if (affix.isGreater == true) {
          final greaterCount = this.affixes.where((entry) => entry.isGreater == true).length
          if (greaterCount >= countInfo.maxGreater) {
            throw('Too many greater affixes for target equipment: ${affix.id}')
          }
          if (sourceRank != null) affix.level = maxLevelForRank(sourceRank)
          affix.value = calculatePassiveAffixValue(affix,
            level: affix.level, isGreater: true)
        }
        let uniqueIds
        if (affix.uniqueIds is List) {
          uniqueIds = affix.uniqueIds
        } else {
          uniqueIds = [affix.uniqueId ?? affix.id]
        }
        for (final uniqueId in uniqueIds) {
          if (this.affixUniqueIds.contains(uniqueId)) {
            throw('Duplicate affix for target equipment: ${affix.id}')
          }
        }
        this.affixes.add(affix)
        this.affixUniqueIds.addAll(uniqueIds)
      }
    }

    rollGreaterPassiveAffixes(this, Constants.greaterAffixGenerationChance)
    calculatePrice(this)

    this.experienced = []
  }
}
