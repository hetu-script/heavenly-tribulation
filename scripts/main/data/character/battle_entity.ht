
import '../achievements.ht'

// number of the avatar images
const _kAvatarCount = 41

const _kCostumeCount = 5
const _kCostumeColorCount = 3

const _kInitialMoneyPerLevel = 500
const _kInitialShardPerRank = 15

/// 容貌等数值计算时的最大值: 100.0
const kAttributeValueMax = 100.0;
const kNonBattleAttributeValueAverage = 50.0;
const kNonBattleAttributeValueMajor = 75.0;
const kNonBattleAttributeValueDeviation = 25.0;
const kBattleAttributesValueBase = 25
const kBattleAttributesValueMajor = 50

const kBattleCardBasicAttacks = [
  'punch',
  'kick',
];

const kBattleCardBasicBuffs = [
  'punch',
  'kick',
  'xinfa',
  'shenfa',
  'qinggong',
];

const kBattleCardWeaponKinds = [
  'sabre',
  'sword',
  'spear',
  'staff',
  'bow',
  'dart',
];

const kBattleCardGenreWeaponKinds = {
  'bodyforge': ['sabre'],
  'swordcraft': ['sword'],
  'spellcraft': [],
  'vitality': ['bow', 'dart'],
  'avatar': ['staff', 'spear'],
};

const kEphemeralScopeBattlePreparation = 'battle_preparation'
const kEphemeralScopeStandalone = 'standalone'

/// 被动词条聚合结果：由 passivesRaw / ephemeralPassivesRaw 全量派生。
/// level 仅用于展示，value 是同 ID 全部来源的未取整贡献汇总后再取整的结果。
struct PassiveData {
  constructor ({
    id,
    priority,
    level,
    value,
    increment,
    description,
    sourceCount,
  }) {
    assert(id != null && description != null)
    this.id = id
    this.priority = priority ?? 0
    this.level = level ?? 0
    this.value = value
    this.increment = increment
    this.description = description
    this.sourceCount = sourceCount ?? 0
  }
}

/// battle entity 指一个可以参与战斗的对象。
/// 此对象拥有一个牌库和一个卡组。
/// 卡组是战斗中使用的。而牌库可以用来交换卡牌收藏（偷取、学习或者交换）。
struct BattleEntity {
  constructor ({
    id,
    isFemale,
    race,
    icon,
    illustration,
    skin,
    name,
    shortName,
    surName,
    generationName,
    generateName = true,
    description,
    level,
    rank,
    attributes,
    stats,
    allocateSkills = true,
    autoGenerateDeck = true,
    cultivationFavor,
    cultivationStyle,
  }) {
    this.entityType = kEntityTypeBattleEntity
    this.isFemale = isFemale ?? random.nextBool()
    if (race != null) {
      assert(Constants.races.contains(race))
      this.race = race
    } else {
      this.race = random.nextIterable(Constants.races)
    }

    const sex = this.isFemale ? 'female' : 'male'
    this.illustration = illustration
    if (icon == null) {
      const avatarIndex = random.nextInt(_kAvatarCount)
      this.icon = 'illustration/avatar/${this.race}/${sex}/${avatarIndex}.png'
    } else {
      this.icon = icon
    }
    // this.usedNames = []
    this.skin = skin ?? '${sex}_${this.race}_costume${random.nextInt(_kCostumeCount) + 1}_color${random.nextInt(_kCostumeColorCount) + 1}'

    if (name == null && generateName) {
      let randomName
      let conflict = false
      do {
        randomName = generateCharacterName(
          isFemale: this.isFemale,
          surName: surName,
          middleName: generationName,
        )
        conflict = game.characters[randomName.fullName] != null
      } while (conflict)
      this.name = randomName.fullName
      this.surName = randomName.surName
      this.generationName = randomName.middleName
      this.shortName = randomName.shortName
    } else {
      this.name = name ?? engine.locale('noname')
      this.surName = surName
      this.generationName = generationName
      this.shortName = shortName ?? name
    }
    this.id = id ?? this.name
    
    // 非主角色不参与 update, interact 等逻辑交互，也不会自动显示在地图或场景中。
    // this.isMain = isMain ?? false

    this.description = description ?? ''

    // 修真境界，凝气期是1
    // 在所有流派中，只有修为等级最高的那个流派决定了境界
    this.rank = rank ?? 0
    // 修为等级，每次提升修为等级可以获得1点天赋点
    this.level = level
    final minLevel = minLevelForRank(this.rank)
    final maxLevel = maxLevelForRank(this.rank)
    if (this.level == null) {
      this.level = random.nextInt(maxLevel - minLevel + 1) + minLevel
    } else {
      this.level = this.level.clamp(minLevel, maxLevel)
    }

    this.life = 1
    this.tribulationCount = 0

    // 身上携带的材料，材料本身没有特殊属性，多个材料只是堆叠数字增加
    // 材料单独显示在物品栏上方，没有携带的材料不会显示
    // 金钱也是一种材料，其他材料包括可以用来建筑的木材、石料等
    this.materials = {
      money: _kInitialMoneyPerLevel * (this.level + 2),
      shard: _kInitialShardPerRank * (this.rank),
    }

    // 身上携带的普通物品，每一个都是单独生成，无法堆叠
    this.inventory = {}

    // 装备栏固定 8 格，可用栏位数随境界提升（见 equipmentSlotCount）
    // 装备栏只能装备法宝，获得其佩戴效果
    // key 是 0-7 的数字，代表第几栏，
    // value 是 物品的 id，物品的具体数据在角色的 inventory 中
    this.equipments = {
      '0': null,
      '1': null,
      '2': null,
      '3': null,
      '4': null,
      '5': null,
      '6': null,
      '7': null,
    }

    // 随角色移动的其他角色，这里只保存id
    this.companions = []

    // 角色当前卡牌库，关于战斗卡牌的具体信息另行参阅文档
    // 卡牌库是一个 map，key 是卡牌的 id，value 是卡牌数据
    this.cardLibrary = {}
    // 战斗卡组的数组，数组的值是一个结构体，包含卡组的命名（可修改）和卡组内容
    // [
    //   {
    //     title: 'deck name',
    //     isBattleDeck: false, // 是否是当前使用的战斗卡组
    //     // isValid: false, // 卡组是否合法（数量，装备要求等是否满足）
    //     cards: [
    //       'card id 1', // 卡组中只保存卡牌id，实际数据在角色的library中
    //       'card id 2',
    //     ]
    //   }
    // ]
    this.battleDecks = []
    // 当前使用的战斗卡组，记录的是战斗卡组数组的index
    this.battleDeckIndex = -1

    // 角色的属性
    // 包括: 灵力、身法、体魄、念力、神识
    if (attributes == null) {
      generateAttributes(this)
    } else {
      for (final id in Constants.attributes) {
        this[id] = attributes[id] ?? 0
      }
    }
    
    // 已解锁的天赋技能节点， key 是 nodeId ，代表天赋盘上某个位置的坐标。
    // 如果存在某个 key 意味着该位置已经被解锁
    // 对于属性类节点，值是该属性的名字
    // 对于其他节点，值是 true
    this.unlockedPassiveTreeNodes = {}

    // 永久/临时被动的唯一真值：Map<被动id, Map<sourceKey, 完整来源快照>>
    this.passivesRaw = {}
    this.ephemeralPassivesRaw = {}

    // 由 Raw 全量派生的聚合结果，业务代码不得直接修改
    this.passives = {}
    this.ephemeralPassives = {}

    // 在秘境中获得的被动加成，将会在离开秘境时移除
    this.dungeonPassives = {}

    // 角色的数值
    // 包括经过物品、天赋和状态加成的基本属性值
    // 通过属性还会计算出: 攻击、防御、体力、生命、灵气
    this.stats = stats ?? {}

    // 煞气: 角色击败过的其他角色的数量，本身也是一种资源，可以被消耗
    this.karma = 0
    
    this.mainAttribute = getMainAttribute(this)

    // 主流派: 御剑、道术、锻体、炼魂、法身
    this.cultivationFavor = cultivationFavor ?? Constants.attributeToGenre[this.mainAttribute]
    // 加点路线
    this.cultivationStyle = cultivationStyle ?? random.nextIterable(Constants.cultivationStyles[this.mainAttribute])
    
    this.achievements = Achievements()

    if (allocateSkills) {
      Game.characterAllocateSkills(this, rejuvenate: true)
    } else {
      characterCalculateStats(this, rejuvenate: true)
    }
    
    if (autoGenerateDeck) {
      generateBattleDeck(this)
    }
  }
}

function generateAttributes(entity) {
  let mainAttributes = Constants.raceMainAttributes[entity.race]
  assert(mainAttributes != null, 'raceMainAttributes not found, ${entity.race}');

  let attributes = {}
  for (final id in Constants.nonBattleAttributes) {
    attributes[id] = Math.gaussianNoise(
      mainAttributes.contains[id] ? kNonBattleAttributeValueMajor : kNonBattleAttributeValueAverage,
      kNonBattleAttributeValueDeviation,
      min: 1,
      max: kAttributeValueMax,
      randomGenerator: random,
    ).round()
  }
  for (final id in Constants.battleAttributes) {
    if (mainAttributes.contains(id)) {
      attributes[id] = random.nearInt(kBattleAttributesValueMajor)
    } else {
      attributes[id] = random.distantInt(kBattleAttributesValueBase)
    }
  }
  Object.assign(entity, attributes)
}

function getMainAttribute(character) {
  let maxAttr = Constants.battleAttributes.first
  let maxValue = character[maxAttr]

  for (final attr in Constants.battleAttributes) {
    if (character[attr] > maxValue) {
      maxAttr = attr
      maxValue = character[attr]
    }
  }

  return maxAttr
}

/// 当前状态数值，由特性、属性、物品、天赋、技能、增益减损等计算得来
/// 状态包括: 生命、伤害、防御等。
function characterCalculateStats(character, { reset = false, rejuvenate = false}) {
  characterRecalculatePassives(character)
  // stats 全部为派生数据，每次从干净对象重建，避免 statsBonus 等重复累计。
  character.stats = {}

  character.lifeMax = Constants.baseLife + character.level * Constants.baseLifePerLevel
  character.battleLifeMax = character.lifeMax + character.strength
  character.karmaMax = character.willpower ~/ 10

  character.tribulationCountMax = getTribulationCountForRank(character.rank)
  character.lightRadius = Constants.baseLightRadius + character.perception ~/ 10
  character.monthlyIdentifyCardsMax = Constants.baseMonthlyIdentifyCardsMax + character.perception
  character.meditateSpeed = Constants.baseMeditateSpeed
  character.expCollectEfficiency = 1.0
  character.plainMoveSpeed = Constants.basePlainMoveSpeed
  character.mountainMoveSpeed = Constants.baseMountainMoveSpeed
  character.waterMoveSpeed = Constants.baseWaterMoveSpeed
  character.mountainMoveStaminaCost = Constants.baseMountainMoveStaminaCost
  character.waterMoveStaminaCost = Constants.baseWaterMoveStaminaCost
  character.workEfficiency = 1.0
  character.workStaminaCost = 1.0
  character.craftMaterialCost = 1.0

  character.fireResistMax = Constants.baseResistMax
  character.iceResistMax = Constants.baseResistMax
  character.lightningResistMax = Constants.baseResistMax
  character.poisonResistMax = Constants.baseResistMax

  character.quickThreshold = Constants.baseTurnActionThreshold
  character.slowThreshold = Constants.baseTurnActionThreshold
  character.nimbleThreshold = Constants.baseTurnActionThreshold
  character.clumsyThreshold = Constants.baseTurnActionThreshold
  character.critThreshold = Constants.baseCritThreshold
  character.ailmentThreshold = Constants.baseAilmentThreshold

  // 基础属性，在此基础上还要加上物品和状态的加成
  character.stats.charisma = character.charisma + character.passives.charisma?.value
  character.stats.wisdom = character.wisdom + character.passives.wisdom?.value
  character.stats.luck = character.luck + character.passives.luck?.value

  character.stats.dexterity = character.dexterity + character.passives.dexterity?.value + character.ephemeralPassives.dexterity?.value
  character.stats.spirituality = character.spirituality + character.passives.spirituality?.value + character.ephemeralPassives.spirituality?.value
  character.stats.strength = character.strength + character.passives.strength?.value + character.ephemeralPassives.strength?.value
  character.stats.perception = character.perception + character.passives.perception?.value + character.ephemeralPassives.perception?.value
  character.stats.willpower = character.willpower + character.passives.willpower?.value + character.ephemeralPassives.willpower?.value

  character.stats.lifeMax = character.lifeMax + character.passives.lifeMax?.value + character.ephemeralPassives.lifeMax?.value
  character.stats.battleLifeMax = character.stats.lifeMax + character.stats.strength + character.passives.battleLifeMax?.value + character.ephemeralPassives.battleLifeMax?.value
  character.stats.karmaMax = character.stats.willpower ~/ 10 + character.passives.karmaMax?.value + character.ephemeralPassives.karmaMax?.value
  
  if (character.rank > 0) {
    character.stats.tribulationCountMax = (character.tribulationCountMax * (1 + character.passives.tribulationCountMax?.value / 100) * (1 + character.ephemeralPassives.tribulationCountMax?.value / 100)).round()
  } else {
    character.stats.tribulationCountMax = -1
  }
  character.stats.monthlyIdentifyCardsMax = Constants.baseMonthlyIdentifyCardsMax + character.stats.perception + character.passives.monthlyIdentifyCardsMax?.value + character.ephemeralPassives.monthlyIdentifyCardsMax?.value
  character.stats.lightRadius = Constants.baseLightRadius + character.stats.perception ~/ 10 + character.passives.lightRadius?.value + character.ephemeralPassives.lightRadius?.value
  character.stats.plainMoveSpeed = (character.plainMoveSpeed * (1 - character.passives.plainMoveSpeed?.value / 100) * (1 - character.ephemeralPassives.plainMoveSpeed?.value / 100)).toFixed(2)
  character.stats.mountainMoveSpeed = (character.mountainMoveSpeed * (1 - character.passives.mountainMoveSpeed?.value / 100) * (1 - character.ephemeralPassives.mountainMoveSpeed?.value / 100)).toFixed(2)
  character.stats.waterMoveSpeed = (character.waterMoveSpeed * (1 - character.passives.waterMoveSpeed?.value / 100) * (1 - character.ephemeralPassives.waterMoveSpeed?.value / 100)).toFixed(2)
  character.stats.mountainMoveStaminaCost = (character.mountainMoveStaminaCost * (1 + character.passives.mountainMoveStaminaCost?.value / 100) * (1 + character.ephemeralPassives.mountainMoveStaminaCost?.value / 100)).toFixed(2)
  character.stats.waterMoveStaminaCost = (character.waterMoveStaminaCost * (1 + character.passives.waterMoveStaminaCost?.value / 100) * (1 + character.ephemeralPassives.waterMoveStaminaCost?.value / 100)).toFixed(2)
  character.stats.meditateSpeed = (character.meditateSpeed * (1 - character.passives.meditateSpeed?.value / 100) * (1 - character.ephemeralPassives.meditateSpeed?.value / 100)).round()
  character.stats.expCollectEfficiency = (character.expCollectEfficiency * (1 + character.passives.expCollectEfficiency?.value / 100) * (1 + character.ephemeralPassives.expCollectEfficiency?.value / 100)).toFixed(2)
  character.stats.workEfficiency = (character.workEfficiency * (1 + character.passives.workEfficiency?.value / 100) * (1 + character.ephemeralPassives.workEfficiency?.value / 100)).toFixed(2)
  character.stats.workStaminaCost = (character.workStaminaCost * (1 + character.passives.workStaminaCost?.value / 100) * (1 + character.ephemeralPassives.workStaminaCost?.value / 100)).toFixed(2)
  character.stats.craftMaterialCost = (character.craftMaterialCost * (1 + character.passives.craftMaterialCost?.value / 100) * (1 + character.ephemeralPassives.craftMaterialCost?.value / 100)).toFixed(2)

  // 战斗资源词条（仅限装备；ephemeral 读取保留以兼容旧存档，新词条不进临时增益池）
  character.stats.basicEnergyBonus = character.passives.basicEnergyBonus?.value + character.ephemeralPassives.basicEnergyBonus?.value
  character.stats.battleDrawBonus = character.passives.battleDrawBonus?.value + character.ephemeralPassives.battleDrawBonus?.value
  character.stats.deckMinSizeReduce = character.passives.deckMinSizeReduce?.value + character.ephemeralPassives.deckMinSizeReduce?.value
  character.stats.handSizeMax = Constants.battleHandSizeMax
  // 通用 stats 直加：遍历全部原始来源；stats 已在函数开头重建，不会重复累计。
  for (final raw in [character.passivesRaw, character.ephemeralPassivesRaw]) {
    for (final sources in raw.values) {
      for (final passiveData in sources.values) {
        final statsBonus = passiveData['statsBonus']
        if (statsBonus == null) continue
        for (final statId in statsBonus.keys) {
          character.stats[statId] = (character.stats[statId] ?? 0) + statsBonus[statId]
        }
      }
    }
  }

  // 战斗机制按来源聚合；battleStatus 的普通原型绑定在同名被动内只计一次，
  // 数值层数读取永久与临时聚合值之和，其他机制按各自契约消费全部来源。
  final battleStatusMap = {}
  final battleStatusBindings = {}
  final battleStatusParams = {}
  final deckCostReductionRules = []
  final shuffleIntoDeckIds = []
  let turnStartScryTotal = 0
  let extraDrawCount = 0
  let extraDrawCostIncrease
  final energyRetainMap = {}
  for (final raw in [character.passivesRaw, character.ephemeralPassivesRaw]) {
    for (final dataId in raw.keys) {
      final sources = raw[dataId]
      for (final passiveData in sources.values) {
        final battleStatus = passiveData['battleStatus']
        if (battleStatus != null) {
          battleStatusBindings['${dataId}:${battleStatus}'] = {
            dataId: dataId,
            statusId: battleStatus,
          }
          final params = passiveData['statusParams']
          if (params != null) {
            var target = battleStatusParams[battleStatus]
            if (target == null) {
              target = {}
              battleStatusParams[battleStatus] = target
            }
            for (final key in params.keys) {
              final value = params[key]
              final existing = target[key]
              if (value is num && existing is num) {
                target[key] = existing + value
              } else if (value is bool && existing is bool) {
                target[key] = existing || value
              } else if (existing != null && existing != value) {
                engine.warning('Conflicting battleStatus params: ${battleStatus}.${key}')
              } else {
                target[key] = value
              }
            }
          }
        }
        final deckCostReduction = passiveData['deckCostReduction']
        if (deckCostReduction != null) {
          deckCostReductionRules.add(deckCostReduction)
        }
        final shuffleIntoDeck = passiveData['shuffleIntoDeck']
        if (shuffleIntoDeck != null) {
          shuffleIntoDeckIds.addAll(shuffleIntoDeck)
        }
        final turnStartScry = passiveData['turnStartScry']
        if (turnStartScry != null && turnStartScry > 0) {
          turnStartScryTotal += turnStartScry
        }
        final turnStartExtraDraw = passiveData['turnStartExtraDraw']
        if (turnStartExtraDraw != null) {
          final count = turnStartExtraDraw['count']
          if (count != null && count > 0) {
            extraDrawCount += count
          }
          if (turnStartExtraDraw['costIncrease'] != null) {
            extraDrawCostIncrease = turnStartExtraDraw['costIncrease']
          }
        }
        final energyRetain = passiveData['energyRetain']
        if (energyRetain != null) {
          final resourceId = energyRetain['resourceId']
          final max = energyRetain['max']
          if (resourceId != null && max != null && max > 0) {
            final existing = energyRetainMap[resourceId]
            if (existing == null) {
              energyRetainMap[resourceId] = {
                max: max,
                costPerPoint: energyRetain['costPerPoint'] ?? 0,
                costDamageType: energyRetain['costDamageType'] ?? 'pure',
              }
            } else if (max > existing.max) {
              existing.max = max
            }
          }
        }
      }
    }
  }
  for (final binding in battleStatusBindings.values) {
    final dataId = binding.dataId
    final permanentValue = character.passives[dataId]?.value
    final ephemeralValue = character.ephemeralPassives[dataId]?.value
    var value = 0
    if (permanentValue != null) value += permanentValue
    if (ephemeralValue != null) value += ephemeralValue
    battleStatusMap[binding.statusId] =
        (battleStatusMap[binding.statusId] ?? 0) + (value > 0 ? value : 1)
  }
  character.stats.battleStatus = battleStatusMap
  character.stats.battleStatusParams = battleStatusParams
  character.stats.deckCostReduction = deckCostReductionRules
  character.stats.shuffleIntoDeck = shuffleIntoDeckIds
  character.stats.turnStartScry = turnStartScryTotal
  if (extraDrawCount > 0) {
    character.stats.turnStartExtraDraw = {
      count: extraDrawCount,
      costIncrease: extraDrawCostIncrease,
    }
  } else {
    character.stats.turnStartExtraDraw = null
  }
  character.stats.energyRetain = energyRetainMap

  character.stats.unarmedAttack = character.passives.unarmedAttack?.value + character.ephemeralPassives.unarmedAttack?.value
  character.stats.weaponAttack = character.passives.weaponAttack?.value + character.ephemeralPassives.weaponAttack?.value
  character.stats.spellAttack = character.passives.spellAttack?.value + character.ephemeralPassives.spellAttack?.value
  character.stats.curseAttack = character.passives.curseAttack?.value + character.ephemeralPassives.curseAttack?.value

  // 各流派伤害增加（装备/天赋词条 → 属性，战斗开始时转换为同名永久状态图标，每层 1%）
  for (final kind in ['punch', 'kick', 'qinna', 'dianxue', 'sword', 'sabre', 'spear', 'staff', 'bow', 'dart', 'firebend', 'airbend', 'waterbend', 'earthbend', 'lightning_control', 'sigil', 'power_word']) {
    final statId = 'increase_damage_${kind}'
    character.stats[statId] = character.passives[statId]?.value + character.ephemeralPassives[statId]?.value
  }

  // 穿透：单一属性，只作用于物理、无属性和真气伤害
  character.stats.penetration = character.passives.penetration?.value + character.ephemeralPassives.penetration?.value

  // 护甲保持：回合开始时在减半基础上额外保留的护甲百分比（每层 1%）
  character.stats.persistent = character.passives.persistent?.value + character.ephemeralPassives.persistent?.value

  // 暴击：只有物理伤害可以暴击；计数器满阈值后下一次物理伤害暴击，倍率为百分比整数制
  character.stats.critThreshold = (Constants.baseCritThreshold + character.passives.critThreshold?.value + character.ephemeralPassives.critThreshold?.value).clamp(Constants.minChargeThreshold, Constants.maxChargeThreshold)
  character.stats.critMultiplier = Constants.baseCritMultiplier + character.passives.critMultiplier?.value + character.ephemeralPassives.critMultiplier?.value

  // 元素异常：四元素共享计数器，满阈值后下一次元素伤害造成异常；异常伤害倍率为百分比整数制
  character.stats.ailmentThreshold = (Constants.baseAilmentThreshold + character.passives.ailmentThreshold?.value + character.ephemeralPassives.ailmentThreshold?.value).clamp(Constants.minChargeThreshold, Constants.maxChargeThreshold)
  character.stats.ailmentMultiplier = Constants.baseAilmentMultiplier + character.passives.ailmentMultiplier?.value + character.ephemeralPassives.ailmentMultiplier?.value

  // 全元素抗性折算进每一个单抗，属性面板不单独显示全抗
  character.stats.fireResist = character.passives.fireResist?.value + character.passives.elementalResist?.value + character.ephemeralPassives.fireResist?.value + character.ephemeralPassives.elementalResist?.value
  character.stats.iceResist = character.passives.iceResist?.value + character.passives.elementalResist?.value + character.ephemeralPassives.iceResist?.value + character.ephemeralPassives.elementalResist?.value
  character.stats.lightningResist = character.passives.lightningResist?.value + character.passives.elementalResist?.value + character.ephemeralPassives.lightningResist?.value + character.ephemeralPassives.elementalResist?.value
  character.stats.poisonResist = character.passives.poisonResist?.value + character.passives.elementalResist?.value + character.ephemeralPassives.poisonResist?.value + character.ephemeralPassives.elementalResist?.value

  character.stats.fireResistMax = character.fireResistMax + character.passives.fireResistMax?.value + character.passives.elementalResistMax?.value + character.ephemeralPassives.fireResistMax?.value + character.ephemeralPassives.elementalResistMax?.value
  character.stats.iceResistMax = character.iceResistMax + character.passives.iceResistMax?.value + character.passives.elementalResistMax?.value + character.ephemeralPassives.iceResistMax?.value + character.ephemeralPassives.elementalResistMax?.value
  character.stats.lightningResistMax = character.lightningResistMax + character.passives.lightningResistMax?.value + character.passives.elementalResistMax?.value + character.ephemeralPassives.lightningResistMax?.value + character.ephemeralPassives.elementalResistMax?.value
  character.stats.poisonResistMax = character.poisonResistMax + character.passives.poisonResistMax?.value + character.passives.elementalResistMax?.value + character.ephemeralPassives.poisonResistMax?.value + character.ephemeralPassives.elementalResistMax?.value

  if (character.stats.fireResist > character.stats.fireResistMax) {
    character.stats.fireResist = character.stats.fireResistMax
  }
  if (character.stats.iceResist > character.stats.iceResistMax) {
    character.stats.iceResist = character.stats.iceResistMax
  }
  if (character.stats.lightningResist > character.stats.lightningResistMax) {
    character.stats.lightningResist = character.stats.lightningResistMax
  }
  if (character.stats.poisonResist > character.stats.poisonResistMax) {
    character.stats.poisonResist = character.stats.poisonResistMax
  }

  character.stats.quickThreshold = (Constants.baseTurnActionThreshold + character.passives.quickThreshold?.value + character.ephemeralPassives.quickThreshold?.value).clamp(Constants.minTurnActionThreshold, Constants.maxTurnActionThreshold)
  character.stats.slowThreshold = (Constants.baseTurnActionThreshold + character.passives.slowThreshold?.value + character.ephemeralPassives.slowThreshold?.value).clamp(Constants.minTurnActionThreshold, Constants.maxTurnActionThreshold)
  character.stats.nimbleThreshold = (Constants.baseTurnActionThreshold + character.passives.nimbleThreshold?.value + character.ephemeralPassives.nimbleThreshold?.value).clamp(Constants.minTurnActionThreshold, Constants.maxTurnActionThreshold)
  character.stats.clumsyThreshold = (Constants.baseTurnActionThreshold + character.passives.clumsyThreshold?.value + character.ephemeralPassives.clumsyThreshold?.value).clamp(Constants.minTurnActionThreshold, Constants.maxTurnActionThreshold)

  if (rejuvenate) {
    setCharacterLife(character, character.stats.lifeMax)
  }
}

/// 设定生命值，最终值一定大于 0
/// 若尝试将生命设为小于 0 则会触发劫数 并返回 true
function setCharacterLife(character, life, { overflow = false }) {
  let isDying = false
  if (life <= 0) {
    engine.warning('角色 ${character.id} 遭遇劫数，生命值重设为 1')
    life = 1.0
    isDying = true
    character.tribulationCount += 1
  } else if (!overflow && life > character.stats.lifeMax) {
    life = character.stats.lifeMax
  }
  character.life = life.toDouble()

  return isDying
}

/// 恢复指定角色指定数量的生命，不会超过当前生命上限，并返回实际恢复的数值
function characterRestoreLife(character, amount) {
  assert(amount > 0)
  let before = character.life
  setCharacterLife(character, character.life + amount, overflow: false)
  return character.life - before
}

function getCharacterStats(character) {
  const stats = character.stats.clone()
  return stats
}

/// 返回一个包含可移动的tile kind的列表
/// 如果不为null且非空，则英雄可以开始尝试向这个格子移动，但中途有可能停下
/// 否则不会进入移动路径计算
function getCharacterMovableTerrainKinds(character) {
  let aircraft = characterEquippedCategory(character, 'aircraft')
  if (aircraft) {
    return Constants.terrainKindsAll
  } else {
    let kinds = Constants.terrainKindsLand.toList()
    if (characterEquippedKind(character, 'boots')) {
      kinds.addAll(Constants.terrainKindsMountain)
    }
    if (characterEquippedKind(character, 'ship')) {
      kinds.addAll(Constants.terrainKindsWater)
    }
    return kinds
  }
}

/// 创建一条独立的被动来源快照。Object.create 会深拷贝自有字段及嵌套配置，
/// 聚合只读取快照自有字段，不通过原型链补取数值或机制。
function _createPassiveSource(data, {
  sourceKey,
  sourceType,
  sourceId,
  affixIndex,
  isMain,
  level,
  ephemeralScope,
}) {
  final source = Object.create(resolveGreaterAffix(data))
  source.sourceKey = sourceKey
  source.sourceType = sourceType
  source.sourceId = sourceId
  source.affixIndex = affixIndex
  source.isMain = isMain ?? (affixIndex != null && affixIndex == 0)
  source.level = level ?? data.level ?? 1
  source.ephemeralScope = ephemeralScope ?? data.ephemeralScope
  return source
}

function characterAddPassiveSource(character, source, {isEphemeral = false}) {
  assert(source.id != null && source.sourceKey != null)
  assert(source.sourceType != null && source.sourceId != null)
  if (isEphemeral) {
    source.ephemeralScope ??= kEphemeralScopeBattlePreparation
  }
  final raw = isEphemeral ? character.ephemeralPassivesRaw : character.passivesRaw
  raw[source.id] ??= {}
  raw[source.id][source.sourceKey] = source
}

function characterAddPassiveSourceById(character, dataId, {
  level = 1,
  sourceKey,
  sourceType,
  sourceId,
  affixIndex,
  isMain,
  isEphemeral = false,
  ephemeralScope,
}) {
  final data = game.passives[dataId]
  assert(data != null, 'passive data not found! id: ${dataId}')
  final source = _createPassiveSource(data,
    sourceKey: sourceKey,
    sourceType: sourceType,
    sourceId: sourceId,
    affixIndex: affixIndex,
    isMain: isMain,
    level: level,
    ephemeralScope: ephemeralScope,
  )
  characterAddPassiveSource(character, source, isEphemeral: isEphemeral)
}

function characterGetBattlePreparationSummary(character) {
  var count = 0
  var greaterCount = 0
  for (final sources in character.ephemeralPassivesRaw.values) {
    for (final source in sources.values) {
      if (source.isPermanent == true) continue
      if ((source.ephemeralScope ?? kEphemeralScopeBattlePreparation) !=
          kEphemeralScopeBattlePreparation) continue
      ++count
      if (source.isGreater == true) ++greaterCount
    }
  }
  return {count: count, greaterCount: greaterCount}
}

function _removeBattlePreparationSources(character, {dataId}) {
  final raw = character.ephemeralPassivesRaw
  for (final id in raw.keys.toList()) {
    if (dataId != null && id != dataId) continue
    final sources = raw[id]
    for (final sourceKey in sources.keys.toList()) {
      final source = sources[sourceKey]
      if (source.isPermanent != true &&
          (source.ephemeralScope ?? kEphemeralScopeBattlePreparation) ==
              kEphemeralScopeBattlePreparation) {
        delete sources[sourceKey]
      }
    }
    if (sources.isEmpty) delete raw[id]
  }
}

/// 先构建全部新快照，再整体替换非永久战前配置；永久与独立临时来源保留。
function characterReplaceBattlePreparationPassives(character, newPassives) {
  final prepared = []
  for (final entry in newPassives) {
    assert(entry.id != null && entry.sourceKey != null)
    assert(entry.sourceType != null && entry.sourceId != null)
    prepared.add(_createPassiveSource(entry,
      sourceKey: entry.sourceKey,
      sourceType: entry.sourceType,
      sourceId: entry.sourceId,
      affixIndex: entry.affixIndex,
      isMain: entry.isMain,
      level: entry.level,
      ephemeralScope: kEphemeralScopeBattlePreparation,
    ))
  }
  _removeBattlePreparationSources(character)
  for (final source in prepared) {
    characterAddPassiveSource(character, source, isEphemeral: true)
  }
  characterCalculateStats(character, rejuvenate: false)
  return true
}

function characterRemovePassiveSource(character, dataId, sourceKey, {isEphemeral = false}) {
  final raw = isEphemeral ? character.ephemeralPassivesRaw : character.passivesRaw
  final sources = raw[dataId]
  if (sources == null) return
  delete sources[sourceKey]
  if (sources.isEmpty) delete raw[dataId]
}

function characterRemovePassiveSourcesByOwner(character, sourceType, sourceId, {isEphemeral = false}) {
  final raw = isEphemeral ? character.ephemeralPassivesRaw : character.passivesRaw
  for (final dataId in raw.keys.toList()) {
    final sources = raw[dataId]
    for (final sourceKey in sources.keys.toList()) {
      final source = sources[sourceKey]
      if (source.sourceType == sourceType && source.sourceId == sourceId) {
        delete sources[sourceKey]
      }
    }
    if (sources.isEmpty) delete raw[dataId]
  }
}

function _recalculatePassiveGroup(raw) {
  final result = {}
  for (final dataId in raw.keys) {
    final sources = raw[dataId]
    if (sources.isEmpty) continue
    final first = sources.values.first
    var levelTotal = 0
    var valueTotal = 0.0
    var hasValue = false
    for (final source in sources.values) {
      levelTotal += source.level ?? 1
      if (source.base != null || source.increment != null) {
        hasValue = true
        valueTotal += calculatePassiveAffixContribution(source,
          level: source.level ?? 1,
          isGreater: source.isGreater == true && source.isMain != true)
      }
    }
    result[dataId] = PassiveData(
      id: dataId,
      priority: first.priority ?? 0,
      level: levelTotal,
      value: hasValue ? valueTotal.round() : null,
      increment: first.increment,
      description: first.description,
      sourceCount: sources.length,
    )
  }
  return result
}

/// 从两组 Raw 全量重建最终 Map；最终 Map 仅供查询和展示，不作为来源真值。
function characterRecalculatePassives(character) {
  character.passives = _recalculatePassiveGroup(character.passivesRaw)
  character.ephemeralPassives = _recalculatePassiveGroup(character.ephemeralPassivesRaw)
}

function _addEquipmentPassiveSources(character, item) {
  if (item.affixes is! List) return
  for (var i = 0; i < item.affixes.length; ++i) {
    final source = _createPassiveSource(item.affixes[i],
      sourceKey: 'equipment:${item.id}:${i}',
      sourceType: 'equipment',
      sourceId: item.id,
      affixIndex: i,
    )
    characterAddPassiveSource(character, source)
  }
}

/// 已装备物品的词条或等级变化后，按装备 UID 全量同步对应来源。
function characterRefreshEquipmentPassives(character, item) {
  characterRemovePassiveSourcesByOwner(character, 'equipment', item.id)
  _addEquipmentPassiveSources(character, item)
}

function characterClearEphemeralPassives(character) {
  final raw = character.ephemeralPassivesRaw
  for (final dataId in raw.keys.toList()) {
    final sources = raw[dataId]
    for (final sourceKey in sources.keys.toList()) {
      if (sources[sourceKey].isPermanent != true) {
        delete sources[sourceKey]
      }
    }
    if (sources.isEmpty) delete raw[dataId]
  }
}

/// 检查角色是否拥有某个天赋技能，并将其数据返回
function characterHasPassive(character, dataId) {
  return character.passives[dataId]
}

function generateBattleDeck(character, { maxOutLevel = false, cardInfoList }) {
  let deck = []
  if (cardInfoList is List && cardInfoList.isNotEmpty) {
    for (final info in cardInfoList) {
      final card = BattleCard(
        category: info.category,
        affixId: info.affixId,
        kind: info.kind,
        genre: info.genre,
        rank: info.rank,
        maxOutLevel: maxOutLevel,
        maxRank: info.maxRank ?? character.rank,
        isIdentified: info.isIdentified ?? false,
      )
      deck.add(card)
    }
  } else {
    let weaponKind = random.nextIterable(kBattleCardGenreWeaponKinds[character.cultivationFavor])
    let weaponKind2 = random.nextIterable(kBattleCardWeaponKinds)
    let buffs = []
    let attacks = []
    for (var i in range(getDeckMinSizeForRank(character.rank))) {
      let genre = character.rank > 0 ? character.cultivationFavor : null
      final isBuff = random.nextDouble() < 0.35
      let kind
      final kindRoll = random.nextDouble()
      if (kindRoll < 0.35) {
        if (weaponKind != null) {
          kind = weaponKind
        } else {
          kind = weaponKind2
          genre = 'none'
        }
      } else {
        if (character.rank == 0) {
          if (isBuff) {
            kind = random.nextIterable(kBattleCardBasicBuffs)
          } else {
            kind = random.nextIterable(kBattleCardBasicAttacks)
          }
        } else {
          if (isBuff) {
            kind = random.nextIterable(Constants.battleCardGenreBuffs[genre])
          } else {
            kind = random.nextIterable(Constants.battleCardGenreAttacks[genre])
          }
        }
      }
      // 武器卡牌不限制 category，让 BattleCard 按 kind+genre 从数据中自然匹配
      // （部分武器仅有 attack 卡，部分同时有 defend 类 buff 卡）
      final card = BattleCard(
        category: kindRoll < 0.35 ? null : (isBuff ? 'buff' : 'attack'),
        genre: genre,
        kind: kind,
        // distantInt 偏向低境界：防止 NPC 卡手（低境界卡费用低、无使用门槛）
        maxRank: character.rank,
        isIdentified: false,
      )
      deck.add(card)
    }
    
    // 装备境界均匀随机（物品无卡手问题，无需低境界偏向）
    final equipment = Equipment(kind: weaponKind ?? weaponKind2, rank: random.nextInt(character.rank + 1))
    characterEquip(character, equipment)
  }
  for (final card in deck) {
    characterAcquireBattleCard(character, card, incurIncident: false)
  }
  character.battleDecks.add({
    title: 'battleDeck',
    isBattleDeck: true,
    cards: deck.map((card) => card.id).toList(),
  })
  character.battleDeckIndex = character.battleDecks.length - 1
  
  engine.info('为 ${character.name} 生成了战斗卡组: [${deck.map((card) => card.name).join(', ')}]')
}

function characterEquip(entity, item, { index }) {
  assert(entity.entityType == kEntityTypeBattleEntity || entity.entityType == kEntityTypeCharacter, entity.entityType)
  assert(index == null || (index >= 0 && index < equipmentSlotCount(entity.rank)))

  if (entity.inventory[item.id] == null) {
    // engine.warning('${item.name} 不在${entity.name}的物品栏中，无法装备。')
    item = entityAcquire(entity, item, incurIncident: false)
  }

  if (!item.isEquippable) {
    engine.warning('${item.name} 无法装备。')
    return false
  }
  if (item.equippedPosition) {
    engine.warning('${item.name} 已经在装备中了。')
    return false
  }

  // 绝世装备：同一 uniqueId 同时只能装备一件
  if (item.isUnique == true &&
      characterEquippedUnique(entity, item.uniqueId, excludeItemId: item.id)) {
    engine.warning('${entity.name} 已经装备了同种的绝世装备，无法重复装备。')
    return false
  }

  let equipped = false
  // 如果有空位就装备在空位上（仅使用当前境界已解锁的栏位）
  if (index == null) {
    for (const i in range(equipmentSlotCount(entity.rank))) {
      if (entity.equipments[i] == null) {
        entity.equipments[i] = item.id
        item.equippedPosition = i
        equipped = true
        break
      }
    }
    // 否则替换掉第一个空位
    // index = 0
  }

  // if (!equipped) {
  //   assert(index != null)

  //   const oldEquipId = entity.equipments[index]
  //   if (oldEquipId != null) {
  //     const oldItem = entity.inventory[oldEquipId]
  //     delete oldItem.equippedPosition
  //   }
  //   entity.equipments[index] = item.id
  //   item.equippedPosition = index
  //   equipped = true
  // }

  if (equipped) {
    if (item.affixes is List) {
      _addEquipmentPassiveSources(entity, item)
      // 重新计算角色状态值
      characterCalculateStats(entity, rejuvenate: false)
    }

    if (entity == hero) {
      engine.info('${entity.name}装备了${item.name}')
      onGameEvent('onEquip', item)
    }
  }

  return equipped
}

function characterUnequip(entity, item) {
  assert(item.equippedPosition != null)
  entity.equipments[item.equippedPosition] = null
  delete item.equippedPosition

  if (item.affixes is List) {
    characterRemovePassiveSourcesByOwner(entity, 'equipment', item.id)
    // 重新计算角色状态值
    characterCalculateStats(entity, rejuvenate: false)
  }
  
  engine.info('${entity.name}取下了${item.name}')
}

function characterEquippedCategory(entity, category) {
  let count = 0
  for (final itemId in entity.equipments.values) {
    if (itemId == null) continue
    final item = entity.inventory[itemId]
    if (item.category == category) {
      ++count
    }
  }
  return count
}

/// 检查是否已装备某个 uniqueId 的绝世装备
/// excludeItemId 用于排除物品自身（比如它已经装备在身上时）
function characterEquippedUnique(entity, uniqueId, { excludeItemId }) {
  if (uniqueId == null) return false
  for (final itemId in entity.equipments.values) {
    if (itemId == null) continue
    if (excludeItemId != null && itemId == excludeItemId) continue
    final item = entity.inventory[itemId]
    if (item.uniqueId != null && item.uniqueId == uniqueId) {
      return true
    }
  }
  return false
}

function characterFirstEquippedCategory(entity, category) {
  for (final itemId in entity.equipments.values) {
    if (itemId == null) continue
    final item = entity.inventory[itemId]
    if (item.category == category) {
      return item
    }
  }
  return null
}

function characterEquippedKind(entity, kind) {
  let count = 0
  for (final itemId in entity.equipments.values) {
    if (itemId == null) continue
    final item = entity.inventory[itemId]
    if (item.kind == kind) {
      ++count
    }
  }
  return count
}

function characterFirstEquippedKind(entity, kind) {
  for (final itemId in entity.equipments.values) {
    if (itemId == null) continue
    final item = entity.inventory[itemId]
    if (item.kind == kind) {
      return item
    }
  }
  return null
}

/// 写入单条临时被动；同 ID 使用稳定 sourceKey，保持原有覆盖语义。
/// 未显式分类时读取原型 scope，仍未分类则归为战前配置。
function characterSetEphemeralPassive(character, dataId, {level = 1, ephemeralScope}) {
  if (level == 0) {
    engine.warning('Character gain passive error: level is zero')
    return
  }
  characterAddPassiveSourceById(character, dataId,
    level: level,
    sourceKey: 'script:ephemeral:${dataId}',
    sourceType: 'script',
    sourceId: 'ephemeral',
    isMain: false,
    isEphemeral: true,
    ephemeralScope: ephemeralScope,
  )
}

function _createPotionPassiveSnapshot(item, affix, affixIndex) {
  return _createPassiveSource(affix,
    sourceKey: 'potion:${item.id}:${affixIndex}',
    sourceType: 'potion',
    sourceId: item.id,
    affixIndex: affixIndex,
    ephemeralScope: kEphemeralScopeBattlePreparation,
  )
}

function characterConsumePotion(entity, item) {
  assert(item.category == kItemCategoryPotion)

  engine.info('${entity.name}服用了${item.name}')

  final hasExtraAffixes = item.affixes.length > 1
  final newPassives = []
  final mainAffix = item.affixes.first
  switch (mainAffix.id) {
    case 'heal': {
      if (entity.life < entity.stats.lifeMax) {
        characterRestoreLife(entity, mainAffix.value)
      }
    }
    case 'overheal': {
      let currentLife = Math.min(entity.life, entity.stats.lifeMax)
      let targetLife = currentLife + mainAffix.value
      if (entity.life < targetLife) {
        setCharacterLife(entity, targetLife, overflow: true)
      }
    }
    case 'decreaseTribulationDifficulty': {
      // 独立效果不加入战前配置批次，保留渡劫消费时的精确移除键。
      characterSetEphemeralPassive(entity, mainAffix.id,
        level: mainAffix.level, ephemeralScope: kEphemeralScopeStandalone)
    }
    else: {
      final snapshot = _createPotionPassiveSnapshot(item, mainAffix, 0)
      if (hasExtraAffixes) {
        newPassives.add(snapshot)
      } else {
        // 仅主词条丹药只精确更新同 ID 旧战前来源，不影响其他配置。
        _removeBattlePreparationSources(entity, dataId: mainAffix.id)
        characterAddPassiveSource(entity, snapshot, isEphemeral: true)
      }
    }
  }

  for (var i = 1; i < item.affixes.length; ++i) {
    newPassives.add(_createPotionPassiveSnapshot(item, item.affixes[i], i))
  }
  if (hasExtraAffixes) {
    characterReplaceBattlePreparationPassives(entity, newPassives)
  } else {
    characterCalculateStats(entity, rejuvenate: false)
  }

  entityLose(entity, item)
  return true
}
