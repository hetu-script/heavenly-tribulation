
/// 计算/重算卡牌费用（唯一实现，公开函数；见 plan/battle_resource_rework.md）：
/// 单资源模型——流派卡 = rank 点流派色，中立卡（含法身）= ceil((rank+1)/2) 点元气（life，
/// 即 1,1,2,2,3,3；元气每回合固定产出且无额外获取途径，中立卡保持低价）。
/// 数据层约定全部显式写 coloredCost（含 life 键），本函数只做公式求值并写入
/// card.coloredCost；普通显式 0 = 免费，动态条目即使 base 为 0 也保留为 X。
/// 费用条目可以是固定数值，也可以是 {base, rankIncrement} 公式（随卡牌境界线性缩放，
/// 与词条数值的境界指数公式脱钩），求值统一走 calculateCostValue（GameLogic 外部函数，
/// 声明见 scripts/main/logic/logic.ht；示例：{base: 0, rankIncrement: 1} → 费用 = rank，
/// {base: 0.5, rankIncrement: 0.5} → ceil((rank+1)/2)）。
/// 缺省兜底（数据层不应依赖）：有流派色时推导 rank 点有色（多色对半拆，余数给首位），
/// 无流派色（含法身）推导 ceil((rank+1)/2) 点元气。
/// card.coloredCost 中 life 键始终在首位（渲染时元气在费用行基准位置）。
/// 卡牌生成/破境/动态改费后调用；
/// Dart 侧（如 createBattleCard）通过 engine.hetu.invoke('updateCardCost') 调用
function updateCardCost(card) {
  const explicitCostColored = card.affixes.first.coloredCost
  final costs = {}
  if (explicitCostColored != null && explicitCostColored.isNotEmpty) {
    for (final color in explicitCostColored.keys) {
      final entry = explicitCostColored[color]
      final amount = calculateCostValue(entry, card.rank)
      if (entry is num || entry.isDynamic != true) {
        costs[color] = amount
      } else {
        costs[color] = { base: amount, isDynamic: true }
      }
    }
  } else {
    // 兜底：有色费用 = rank，无色费用 = ((card.rank + 1) / 2).ceil()
    final color = Constants.genreColoredCost[card.genre]
    if (color != null) {
      costs[color] = card.rank
    } else {
      costs[Constants.colorlessCostColorId] = ((card.rank + 1) / 2).ceil()
    }
  }
  // life 在首位：渲染时元气在费用行基准位置（最右）；普通 0 值条目不写入，动态 0 保留为 X
  card.coloredCost = {}
  final life = costs[Constants.colorlessCostColorId]
  if (life != null && (life is! num || life > 0)) {
    card.coloredCost[Constants.colorlessCostColorId] = life
  }
  for (final color in costs.keys) {
    if (color == Constants.colorlessCostColorId) continue
    final amount = costs[color]
    if (amount is! num || amount > 0) {
      card.coloredCost[color] = amount
    }
  }

  // 原始费用基线：供卡面费用行对比变色（增红减黄；减至 0 仍显示图标与黄色 0）。
  // 破境重算费用时基线随之更新；战斗内动态改费（悟道减费、紫微斗数减费等）直接改
  // coloredCost、不经过本函数，基线不受影响
  final baseline = {}
  for (final color in card.coloredCost.keys) {
    final entry = card.coloredCost[color]
    if (entry is num) {
      baseline[color] = entry
    } else {
      baseline[color] = { base: entry.base, isDynamic: true }
    }
  }
  card.originalColoredCost = baseline
}

function getCardRankUpProbability(rank) {
  if (rank == 0) return 1.0;
  if (rank >= kCultivationRankMax) return 0.0;
  return 1 - rank / kCultivationRankMax;
}

/// 创建一张功法战斗卡牌
/// genre 如果为 null，表示可以匹配任意词条
/// 如果为 'none', 表示只匹配没有 genre 要求的词条
struct BattleCard {
  constructor ({
    category, // 'attack', 'buff'
    affixId,
    kind, // 'sword',
    genre, // 'spellcraft', 'swordcraft', 'none', 'scroll'
    level,
    rank, // 境界决定了额外词条数量
    maxOutLevel = false, // 是否最大化等级
    maxRank,
    isIdentified,
    isEphemeral = false,
  }) {
    this.entityType = kEntityTypeBattleCard
    if (rank != null) {
      assert(rank >= 0 && rank <= kCultivationRankMax)
      this.rank = rank
    } else if (maxRank != null) {
      assert(maxRank >= 0 && maxRank <= kCultivationRankMax)
      if (maxRank == 0) {
        this.rank = 0
      } else {
        this.rank = random.nextInt(maxRank + 1)
      }
    } else {
      this.rank = 0
    }

    if (genre != null && genre != 'none' && this.rank == 0) {
      this.rank = 1
    }

    this.id = crypto.randomUID(withTime: true)
    this.isEphemeral = isEphemeral

    this.keywords = []

    // 注意: 主词条数据的genre是字符串，但额外词条的genre是字符串数组
    let mainAffixes = game.battleCards.values.where( (affix) {
      if (affixId != null) {
        return affix.id == affixId
      } else {
        if (affix.isUnpackable) return false
        if (category != null && affix.category != category) return false
        if (affix.rank > this.rank) return false
        if (kind != null && affix.kind != kind) return false
        if (genre != null) {
          if (genre == 'none') {
            if (affix.genre != null) {
              return false
            }
          } else if (genre != affix.genre) {
            return false
          }
        }
        return true
      }
    })

    if (affixId == null && mainAffixes.isNotEmpty) {
      // 两段式 roll：先按概率判定是否出绝世卡，再从对应的词条池中随机
      final uniquePool = mainAffixes.where( (affix) => affix.isUnique == true )
      final normalPool = mainAffixes.where( (affix) => affix.isUnique != true )
      if (random.nextInt(100) < Constants.uniqueCardChance) {
        if (uniquePool.isNotEmpty) {
          mainAffixes = uniquePool
        }
      } else if (normalPool.isNotEmpty) {
        mainAffixes = normalPool
      }
    }

    if (mainAffixes.isEmpty) {
      // 去掉 kind 限制再试一次
      engine.warning('Found no main affix for: id: ${affixId} genre: ${genre}, category: ${category}, kind: ${kind}, rank: ${rank}, try again without kind limit')
      mainAffixes = game.battleCards.values.where( (affix) {
        if (affixId != null) {
          return affix.id == affixId
        } else {
          if (affix.isUnpackable) return false
          if (category != null && affix.category != category) return false
          if (affix.rank > this.rank) return false
          // if (kind != null && affix.kind != kind) return false
          if (genre != null) {
            if (genre == 'none') {
              if (affix.genre != null) {
                return false
              }
            } else if (genre != affix.genre) {
              return false
            }
          }
          return true
        }
      })
    }

    if (mainAffixes.isEmpty) {
      throw('Found no main affix for: id: ${affixId} genre: ${genre}, kind: ${kind}, rank: ${rank}')
    }

    const mainAffix = Object.create(random.nextIterable(mainAffixes))
    mainAffix.isMain = true
    final mainAffixRank = Math.max(mainAffix.rank, this.rank)
    this.cardType = mainAffix.cardType
    this.rank = mainAffix.rank = mainAffixRank
    // 数据层卡牌定义上的标记合并到卡牌实例（Dart 侧读取 card.data 上的这些字段）：
    // isEphemeral（消耗：打出后碎裂移出战斗）、
    // isWildcardCostForbidden（费用禁止以太极之气抵扣，必须本色气全额支付，如绝世·万法归宗）
    this.isEphemeral = mainAffix.isEphemeral ?? false
    this.isUnique = mainAffix.isUnique ?? false
    this.isWildcardCostForbidden = mainAffix.isWildcardCostForbidden ?? false
    if (this.isUnique) {
      this.uniqueId = mainAffix.uniqueId ?? mainAffix.id
    }
    // 绝世卡牌生成时默认未鉴定，需要使用鉴定卷轴鉴定
    this.isIdentified = isIdentified ?? !this.isUnique

    this.affixes = [mainAffix]
    if (this.isUnique) {
      // 绝世卡牌使用固定名字，而非按 kind 随机生成：
      // 以 uniquecard_{主词条id} 为键，保存在 assets/locale/zh/rpg/battlecard.json
      this.name = engine.locale('uniquecard_${mainAffix.id}')
    } else if (mainAffix.kind != null) {
      this.name = generateSkillName(kind: mainAffix.kind)
    } else {
      this.name = engine.locale(mainAffix.id)
    }
    this.image = mainAffix.image
    this.genre = mainAffix.genre
    this.category = mainAffix.category
    this.kind = mainAffix.kind
    this.equipment = mainAffix.equipment
    this.requirement = mainAffix.requirement

    // 费用：单资源模型（见 plan/battle_resource_rework.md），数据层显式 coloredCost，此处求值写入卡牌实例
    updateCardCost(this)

    final minLevel = minLevelForRank(this.rank)
    final maxLevel = maxLevelForRank(this.rank)
    if (level == null) {
      if (maxOutLevel) {
        level = maxLevel
      } else {
        level = minLevel + random.nextInt(maxLevel - minLevel)
      }
    } else {
      level = level.clamp(Math.max(1, minLevel), maxLevel)
    }
    this.level = level
    
    _updateAffixValue(this, mainAffix)

    final affixUniqueIds = []
    if (mainAffix.uniqueIds is List) {
      affixUniqueIds.addAll(mainAffix.uniqueIds)
    } else if (mainAffix.uniqueId is string) {
      affixUniqueIds.add(mainAffix.uniqueId)
    }

    this.affixUniqueIds = affixUniqueIds

    if (this.isUnique) {
      _addPredefinedAffixes(this)
    } else {
      _addExtraAffixes(this)
      _rollGreaterAffixes(this, Constants.greaterAffixGenerationChance)
    }

    _updateAffixUniqueIds(this)
  }
}

function _getSupportAffixes(card) {
  let affixes = []
  for (final affix of game.battleCardAffixes) {
    assert(affix.uniqueId != null)
    // 绝世卡专属词条（inUnpackable）不进随机额外词条池，只能由绝世卡的预定义列表固定授予
    if (affix.inUnpackable == true) {
      continue
    }
    if (!affix.categories.contains(card.category)) {
      continue
    }
    if (affix.genres is List && !affix.genres.contains(card.genre)) {
      continue
    }
    if (card.affixUniqueIds.contains(affix.uniqueId)) {
      continue
    }
    if ((affix.rank ?? 0) > card.rank) {
      continue
    }
    // 生成侧 require 过滤：词条可声明 require 子表，以主词条（card.affixes[0]）字段为准
    // 做生成前过滤——值 true = 该字段非空（如 require: {elementType: true} 限定元素牌）；
    // 值为数组 = 字段值 ∈ 数组；其余 = 等值匹配。不满足则跳过该词条
    if (affix.require != null) {
      final mainAffix = card.affixes[0]
      var required = true
      for (final field in affix.require.keys) {
        final expected = affix.require[field]
        final actual = mainAffix[field]
        if (expected is List) {
          if (!expected.contains(actual)) {
            required = false
            break
          }
        } else if (expected == true) {
          if (actual == null) {
            required = false
            break
          }
        } else if (actual != expected) {
          required = false
          break
        }
      }
      if (!required) {
        continue
      }
    }
    affixes.add(affix)
  }

  if (affixes.isEmpty) {
    engine.warning('Found no support affixes for card: [genre: ${card.genre}, category: ${card.category}, kind: ${card.kind}, rank: ${card.rank}]')  
  }

  return affixes
}

function _updateAffixValue(card, affix) {
  // 主词条等级跟随卡牌；太古额外词条始终取来源卡牌当前境界满级。
  if (affix.isMain) {
    affix.level = card.level
  } else if (affix.isGreater == true) {
    affix.level = maxLevelForRank(card.rank)
  } else if (affix.level == null) {
    affix.level = card.level
  }

  if (affix.valueData is List) {
    final values = []
    final greaterValues = affix.isGreater == true && affix.greater != true
        ? affix.greater?.values
        : null
    for (var i = 0; i < affix.valueData.length; ++i) {
      var greater
      if (affix.isGreater == true && affix.greater == true && i == 0) {
        greater = { mode: 'multiply', factor: Constants.defaultGreaterAffixFactor }
      } else if (greaterValues is List && i < greaterValues.length) {
        greater = greaterValues[i]
      }
      values.add(calculateCardAffixValue(affix.valueData[i],
        level: affix.level, rank: affix.rank, greater: greater))
    }
    affix.value = values
  }
}

function _randomizeAffixLevel(card, affix) {
  if (affix.isGreater == true) {
    _updateAffixValue(card, affix)
    return
  }
  if (affix.valueData is List) {
    final levelMin = minLevelForRank(affix.rank)
    final levelMax = maxLevelForRank(affix.rank)
    affix.level = getRandomLevel(levelMin, levelMax)
    _updateAffixValue(card, affix)
  } else {
    affix.level = 1
  }
}

function _greaterAffixCandidates(card) {
  final candidates = []
  for (var i = 1; i < card.affixes.length; ++i) {
    final affix = card.affixes[i]
    if (affix.isGreater ?? false) continue
    if (affix.greater == null) continue
    candidates.add(affix)
  }
  return candidates
}

function _canAddGreaterAffix(card) {
  final countInfo = getMinMaxExtraAffixCount(card.rank)
  final greaterCount = card.affixes.where((affix) => affix.isGreater == true).length
  return greaterCount < countInfo.maxGreater && _greaterAffixCandidates(card).isNotEmpty
}

function _markAffixGreater(card, affix) {
  assert(affix.isMain != true && affix.greater != null)
  affix.isGreater = true
  affix.isFreezed = true
  affix.rank = card.rank
  _updateAffixValue(card, affix)
}

function _rollSingleGreaterAffix(card, chance, {affix}) {
  if (!_canAddGreaterAffix(card)) return false
  if (affix != null && (affix.isMain == true || affix.isGreater == true || affix.greater == null)) return false
  if (random.nextDouble() >= chance) return false
  final target = affix ?? random.nextIterable(_greaterAffixCandidates(card))
  _markAffixGreater(card, target)
  return true
}

function _rollGreaterAffixes(card, chance) {
  if (!_canAddGreaterAffix(card)) return false
  final candidates = _greaterAffixCandidates(card)
  candidates.shuffle()
  final countInfo = getMinMaxExtraAffixCount(card.rank)
  var marked = false
  for (final affix in candidates) {
    final greaterCount = card.affixes.where((entry) => entry.isGreater == true).length
    if (greaterCount >= countInfo.maxGreater) break
    if (random.nextDouble() < chance) {
      _markAffixGreater(card, affix)
      marked = true
    }
  }
  return marked
}

function _addAffixToCard(card, affix, rank, {index}) {
  affix.rank = Math.min(rank, card.rank)

  _randomizeAffixLevel(card, affix)

  if (index != null) {
    assert(index >= 0 && index <= card.affixes.length)
    card.affixes[index] = affix
  } else {
    card.affixes.add(affix)
  }

  _updateAffixUniqueIds(card)
}

function _updateAffixUniqueIds(card) {
  card.keywords = Set()
  if (!card.isUnique) {
    card.affixUniqueIds = Set()
  }
  for (final affix in card.affixes) {
    card.keywords.addAll(affix.keywords ?? [])
    if (!card.isUnique) {
      if (affix.isMain) {
        if (affix.uniqueIds is List) {
          card.affixUniqueIds.addAll(affix.uniqueIds)
        } else if (affix.uniqueId is string) {
          card.affixUniqueIds.add(affix.uniqueId)
        }
      } else if (affix.uniqueId is string) {
        card.affixUniqueIds.add(affix.uniqueId)
      }
    }
  }
}

function _addExtraAffixes(card) {
  let affixCountInfo = getMinMaxExtraAffixCount(card.rank)

  // 计算额外词条数量
  let extraAffixCount = affixCountInfo.minExtra
  if (affixCountInfo.maxExtra == 0) return
  if (extraAffixCount < affixCountInfo.maxExtra) {
    extraAffixCount += random.nextInt(affixCountInfo.maxExtra - extraAffixCount + 1)
  }

  // 减去已有的额外词条数量（例如被锁定的词条）
  final existingExtraCount = card.affixes.length - 1
  extraAffixCount -= existingExtraCount
  if (extraAffixCount <= 0) return
  
  for (var i = 0; i < extraAffixCount; ++i) {
    // 检索出所有符合条件的额外词条
    let supportAffixes = _getSupportAffixes(card)
    if (supportAffixes.isEmpty) {
      engine.warning('Found no extra affix for: mainAffix: ${card.affixes.first.id} genre: ${card.genre}, category: ${card.category}, kind: ${card.kind}, rank: ${card.rank}')
      break
    }

    let affix = Object.create(random.nextIterable(supportAffixes))

    // 随机生成词条的隐藏境界
    let rank = random.nearInt(card.rank + 1)
    _addAffixToCard(card, affix, rank)
  }
}

function _applyPredefinedGreaterAffixes(card) {
  final growth = card.affixes.first.greaterAffixes
  if (growth is! List) return
  for (final entry in growth) {
    if (entry.rank > card.rank) continue
    final matches = card.affixes.where((affix) {
      return affix.isMain != true && affix.id == entry.affixId
    })
    if (matches.isEmpty) {
      engine.warning('Found no unlocked greater affix for unique card: [${card.affixes.first.id}], affixId: ${entry.affixId}')
      continue
    }
    final affix = matches.first
    if (affix.isGreater != true) _markAffixGreater(card, affix)
  }
}

/// 绝世卡牌最多解锁三个固定额外词条，再按境界应用固定太古成长。
function _addPredefinedAffixes(card) {
  final predefinedAffixIds = card.affixes.first.affixes
  if (predefinedAffixIds is! List) return

  final targetCount = Math.min(predefinedAffixIds.length, card.rank + 1, Constants.maxNormalExtraAffixCount)
  for (var i = card.affixes.length - 1; i < targetCount; ++i) {
    final affixId = predefinedAffixIds[i]
    final prototype = game.battleCardAffixes[affixId]
    if (prototype == null) {
      engine.warning('Found no predefined affix for unique card: [${card.affixes.first.id}], affixId: ${affixId}')
      continue
    }
    final affix = Object.create(prototype)
    _addAffixToCard(card, affix, card.rank)
  }
  _applyPredefinedGreaterAffixes(card)
}

// function identifyCard(card) {
//   if (card.isIdentified == true) {
//     return 'deckbuilding_identifyCard_warning'
//   }

//   card.isIdentified = true

//   // 这里显式返回空值表明成功执行
//   return null
// }

function _addRandomExtraAffix(card, materialRank, {index}) {
  final supportAffixes = _getSupportAffixes(card)
  if (supportAffixes.isEmpty) {
    throw('Found no support affixes for card: [id: ${card.id}, genre: ${card.genre}, category: ${card.category}, kind: ${card.kind}, rank: ${card.rank}]')
  }
  final affix = Object.create(random.nextIterable(supportAffixes))
  _addAffixToCard(card, affix, materialRank, index: index)
  return affix
}

/// 灵宝：优先补槽；满三条且结丹后只进行一次太古判定。
function addAffix(card, materialRank, {index}) {
  if (card.isUnique == true) {
    return engine.locale('craft_unique_forbidden_hint')
  }

  if (index != null) {
    _addRandomExtraAffix(card, materialRank, index: index)
    return null
  }

  final countInfo = getMinMaxExtraAffixCount(card.rank)
  if (card.affixes.length >= countInfo.maxExtra + 1) {
    if (card.rank >= 3 && card.affixes.length >= Constants.maxNormalExtraAffixCount + 1) {
      final succeeded = _rollSingleGreaterAffix(card, Constants.greaterAffixCraftChance)
      if (!succeeded) card.craftResultHint = 'craft_addAffix_greater_failed_hint'
      return null
    }
    return engine.locale('craft_addAffix_warning')
  }

  _addRandomExtraAffix(card, materialRank)
  return null
}

/// 替换一个额外词条，随后只对本次新词条进行一次太古判定。
function replaceAffix(card, materialRank) {
  if (card.isUnique == true) {
    return engine.locale('craft_unique_forbidden_hint')
  }

  final extraAffixes = card.affixes.where( (affix) {
    return (!affix.isMain && !affix.isFreezed)
  }).toList()
  if (extraAffixes.isEmpty) {
    return engine.locale('craft_replaceAffix_warning')
  }
  extraAffixes.sort((a, b) => a.rank.compareTo(b.rank))

  final rank = extraAffixes.first.rank
  final availableAffixes = extraAffixes.where( (affix) => affix.rank == rank)
  final targetAffix = random.nextIterable(availableAffixes)
  final index = card.affixes.indexOf(targetAffix)

  final newAffix = _addRandomExtraAffix(card, materialRank, index: index)
  if (newAffix.isGreater != true) {
    _rollSingleGreaterAffix(card, Constants.greaterAffixCraftChance, affix: newAffix)
  }

  _updateAffixUniqueIds(card)
  return null
}

/// 锁定一个额外词条
/// 已锁定词条数量决定所需真定丹的最低境界: 
/// 0个已锁定 → rank>=1, 1个已锁定 → rank>=2, 以此类推，最多3个
function freezeAffix(card, materialRank) {
  if (card.isUnique == true) {
    return engine.locale('craft_unique_forbidden_hint')
  }

  final frozenCount = card.affixes.where( (affix) => affix.isFreezed == true ).length
  if (frozenCount >= Constants.maxNormalExtraAffixCount) {
    return engine.locale('craft_freezeAffix_warning_maxCount')
  }

  final requiredRank = frozenCount + 1
  if (materialRank < requiredRank) {
    return engine.locale('craft_freezeAffix_warning_materialRank',
      interpolations: [engine.locale('cultivationRank_${requiredRank}')])
  }

  final extraAffixes = card.affixes.where( (affix) {
    return (!affix.isMain && !affix.isFreezed)
  }).toList()
  if (extraAffixes.isEmpty) {
    return engine.locale('craft_freezeAffix_noAffix')
  }
  extraAffixes.sort( (a, b) => b.rank.compareTo(a.rank) )
  
  final rank = extraAffixes.first.rank
  final availableAffixes = extraAffixes.where( (affix) => affix.rank == rank)
  final targetAffix = random.nextIterable(availableAffixes)

  targetAffix.isFreezed = true

  // 这里显式返回空值表明成功执行
  return null
}

function removeAffix(card, materialRank) {
  if (card.isUnique == true) {
    return engine.locale('craft_unique_forbidden_hint')
  }

  final extraAffixes = card.affixes.where( (affix) {
    return (!affix.isMain && !affix.isFreezed && affix.rank <= materialRank)
  }).toList()
  if (extraAffixes.isEmpty) {
    return engine.locale('craft_removeAffix_warning')
  }
  extraAffixes.sort( (a, b) => a.rank.compareTo(b.rank) )
  
  final rank = extraAffixes.first.rank
  final availableAffixes = extraAffixes.where( (affix) => affix.rank == rank)
  final targetAffix = random.nextIterable(availableAffixes)

  card.affixes.remove(targetAffix)

  _updateAffixUniqueIds(card)

  // 这里显式返回空值表明成功执行
  return null
}

/// 重置卡牌的数值
function rerollAffix(card, materialRank) {
  if (materialRank < card.rank) {
    return engine.locale('craft_rerollAffix_warning_materialRank')
  }

  final extraAffixes = card.affixes.where( (affix) {
    return (!affix.isMain && affix.isFreezed != true && affix.valueData != null)
  })

  // 纯机制词条没有数值可重随，但仍可能进行一次合法的太古判定。
  if (extraAffixes.isEmpty && !_canAddGreaterAffix(card)) {
    return engine.locale('craft_rerollAffix_warning')
  }
  
  final minLevel = minLevelForRank(card.rank)
  final maxLevel = maxLevelForRank(card.rank)
  card.level = minLevel + random.nearInt(maxLevel - minLevel)
  _updateAffixValue(card, card.affixes.first)

  for (final affix in extraAffixes) {
    _randomizeAffixLevel(card, affix)
  }

  // 全体数值重随后只进行一次独立太古判定。
  _rollSingleGreaterAffix(card, Constants.greaterAffixCraftChance)
  return null
}

/// 升级卡牌境界
function upgradeRank(card, materialRank) {
  if (card.rank >= kCultivationRankMax) {
    return engine.locale('craft_upgradeRank_warning_maxRank')
  }

  if (materialRank <= card.rank) {
    return engine.locale('craft_upgradeRank_warning_materialRank')
  }
  
  // final nextRankMinLevel = minLevelForRank(card.rank + 1)
  // if (card.level < nextRankMinLevel) {
  //   return engine.locale('craft_upgradeRank_warning', interpolations: [nextRankMinLevel])
  // }

  // final successRate = getCardRankUpProbability(card.rank)
  // if (random.nextDouble() > successRate) {
  //   return 'craft_upgradeRank_failed_hint'
  // }

  card.rank += 1
  card.affixes.first.rank = card.rank

  // 破境后重算费用：有色费用公式随新境界折算，元气费用相应增减
  updateCardCost(card)

  final minLevel = minLevelForRank(card.rank)
  final maxLevel = maxLevelForRank(card.rank)
  final newLevel = minLevel + random.nearInt(maxLevel - minLevel)
  card.level = Math.max(card.level, newLevel)

  if (card.isUnique == true) {
    // 绝世卡牌的词条身份固定：破境时所有既有词条随新境界免费重 roll 数值
    //（与普通卡保留词条的行为一致），并追加下一个预定义词条
    for (final affix in card.affixes) {
      affix.rank = card.rank
      if (affix.isMain) {
        _updateAffixValue(card, affix)
      } else {
        _randomizeAffixLevel(card, affix)
      }
    }
    _addPredefinedAffixes(card)
  } else {
    // 普通破境保留全部词条；普通词条保留当前等级，太古自动满级。
    for (final affix in card.affixes) {
      affix.rank = card.rank
      _updateAffixValue(card, affix)
    }

    final countInfo = getMinMaxExtraAffixCount(card.rank)
    if (card.affixes.length < countInfo.maxExtra + 1 &&
        random.nextDouble() < Constants.rankUpExtraAffixChance) {
      _addRandomExtraAffix(card, card.rank)
    }
    _rollGreaterAffixes(card, Constants.greaterAffixRankUpChance)
  }
  
  _updateAffixUniqueIds(card)

  // 这里显式返回空值表明成功执行
  return null
}

/// 升级卡牌等级
/// 这个操作并非打造操作，而是某些卡牌词条效果可能会用到
/// 永久路径（打造/养剑等持久化场景）clamp 在等级上限；
/// 战斗内临时路径传 inBattle: true，允许突破上限（战斗用牌是深拷贝，临时升级不污染卡库，
/// 增量线性有界）。新指数公式下 +1 级相对提升全境界恒定（≈ increment/base），无需保底补偿。
function upgradeCard(card, {inBattle: bool = false}) {
  if (!inBattle) {
    final maxLevel = maxLevelForRank(card.rank)
    if (card.level >= maxLevel) return
  }
  card.level += 1
  _updateAffixValue(card, card.affixes.first)
}

/// 卡牌包是一种特殊物品，每个卡牌包包含3张牌
/// 其中一张必然是指定的类别、流派、境界和类型的卡牌
/// 另外两张则是随机卡牌，但境界不会超过卡包本身的境界
struct Cardpack {
  constructor ({
    category,
    genre,
    rank,
    kind,
  }) {
    assert(genre == null || genre == 'none' || Constants.cultivationGenres.contains(genre), genre)
    assert(rank == null || (rank >= 0 && rank <= kCultivationRankMax), rank)
    assert(kind == null || Constants.battleCardKinds.contains(kind), kind)
    this.entityType = kEntityTypeItem
    this.createdTimestamp = game.timestamp
    this.type = kItemTypeCardpack
    this.category = kItemCategoryCardpack;
    this.kind = 'cardpack'

    rank ??= 0
    if (rank < 1 && genre != null) {
      rank = 1
    }
    this.rank = rank
    this.filter = {
      category: category,
      genre: genre,
      rank: rank,
      kind: kind,
    }

    this.id = crypto.randomUID(withTime: true)
    final rankString = engine.locale('cultivationRank_${rank}') + engine.locale('rank2')
    final genreString = genre != null ? engine.locale(genre) : ''
    final kindString = kind != null ? engine.locale('kind_${kind}') : ''
    this.name = rankString + genreString + kindString + engine.locale('cardpack')
    this.icon = 'item/craft/cardpack.png'
    
    this.flavortext = engine.locale('flavortext_cardpack')
    this.rarity = Constants.rankToRarity[this.rank]

    // 秘籍无需鉴定
    this.isIdentified = true
    this.isUsable = true

    calculatePrice(this)
  }
}
