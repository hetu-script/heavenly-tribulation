/// 回合结束资源结算已由 Dart 侧 BattleCharacter._settleTurnEndResources 处理
/// （先灵气溢出利用，后元气回血，顺序显式保证）

external class BattleCharacter {
  get data

  get turnFlags

  get cardFlags
  
  get life

  get lifeMax

  function setLifeMax(value: integer, {rejuvenate: bool = false})

  function addHintText(text, {color: string})

  function changeLife(value: integer, {playSound: bool = false, isHeal: bool = false, damageType: string})

  function getElementalResist(damageType: string) -> int

  async function takeDamage(details) -> integer

  async function setState(state, {isOverlay = false})

  async function setCompositeState({
    startup: List,
    recovery: List,
    actions: List,
    overlays: List,
    complete: string = 'stand',
    sound: string,
  })

  function hasStatusEffect(effectId: string) -> int

  function removeStatusEffect(effectId: string, {
    amount: integer,
    percentage: float,
    force: bool = false,
  }) -> integer

  function addStatusEffect(effectId: string, {amount: integer})

  /// options：可选条件表，支持 filter / reduceCost 子表
  /// （字段：category / genre / cardType / kind / elementType，见 CardScript.draw_cards）
  function drawCards(count: integer, {options})

  /// 观星：查看牌库顶 count 张牌（缺省为 3），选一张放回牌库顶，其余进弃牌堆；
  /// 牌库为空时不触发（观星不触发洗牌）
  function scry({count: integer})

  /// 升级手牌：随机升级手牌中 count 张符合 options 条件（category/genre/cardType/kind/elementType）
  /// 的卡牌各 +1 级（inBattle，可突破上限，深拷贝不污染卡库）
  function upgradeHandCards(count: integer, {options})

  /// 获取手牌：返回手牌中完全符合 options 条件（category/genre/cardType/kind/elementType，
  /// 与 upgradeHandCards 同口径；为空则返回全部）的卡牌 data 列表
  function getHandCards({options}) -> List
}
