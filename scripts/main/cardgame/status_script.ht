// import 'battle_character.ht'

/// 战斗状态脚本
/// 每张状态都对应一个脚本
/// 这个脚本将会根据该状态在例如回合开始时等时机触发
/// 状态脚本必须是非阻塞，不能是async
/// 函数的类型固定为: function (self, opponent, effect, details)
/// 战斗角色对象上的 cardFlags 保存了此角色此回合打出的卡牌的一些参数
/// details 则是此次脚本事件本身的参数（如果有的话）

/// 触发时机包括（以 Dart 侧 handleStatusEffectCallback 实际分发点为准）: 
/// 对方/自己回合开始时 opponent/self_turn_start
/// 对方/自己回合结束时 opponent/self_turn_end
/// 对方/自己回合资源产出阶段结束时 opponent/self_produce_resources
/// （产出型效果必须挂这里；更早时机授予的阳气会被 clearResourceEffects 当残留清空）
/// 自己观星结算后 self_scry（details 携带 {count, chosen}）

/// 对方/自己造成伤害时 opponent/self_doing_damage
/// 对方/自己造成伤害后 opponent/self_done_damage
/// 对方/自己受到伤害时 opponent/self_taking_damage
/// 对方/自己受到伤害后 opponent/self_taken_damage

/// 对方/自己获得负面效果后 opponent/self_gained_debuff
/// 对方/自己获得阳气后 opponent/self_gained_energy_positive

/// 对方/自己使用卡牌时 opponent/self_using_card
/// 对方/自己使用卡牌后 opponent/self_used_card
/// 对方/自己使用攻击牌后 opponent/self_attacked
/// 对方/自己使用加持牌后 opponent/self_buffed

/// 按流派/套路细粒度区分的现行模式：挂上述通用时机，在脚本内按
/// details.kind / details.cardType / getLastUsedCard() 等判定（见 increase_damage 等）

namespace StatusScript {

  function increase_damage_self_doing_damage(self, opponent, effect, details) {
    // kinds 列表优先（例如剑法伤害增加同时覆盖剑法和御剑术），回退到单 kind 精确匹配
    if (effect.kinds != null) {
      if (!effect.kinds.contains(details.kind)) return
    } else {
      if (effect.kind != details.kind) return
    }

    let percentage = 0.01 * effect.amount
    details.percentageChange1 += percentage
  }

  function speed_quick_self_turn_end(self, opponent, effect, details) {
    final existed = self.hasStatusEffect('speed_quick')
    final threshold = self.data.stats.quickThreshold
    if (existed >= threshold) {
      self.removeStatusEffect('speed_quick', amount: threshold)
      self.turnFlags.extraTurn = true
    }
  }

  function speed_slow_self_turn_start(self, opponent, effect, details) {
    final existed = self.hasStatusEffect('speed_slow')
    final threshold = self.data.stats.slowThreshold
    if (existed >= threshold) {
      self.removeStatusEffect('speed_slow', amount: threshold)
      self.turnFlags.skipTurn = true
    }
  }

  function dodge_nimble_self_turn_end(self, opponent, effect, details) {
    final existed = self.hasStatusEffect('dodge_nimble')
    final threshold = self.data.stats.nimbleThreshold
    if (existed >= threshold) {
      self.removeStatusEffect('dodge_nimble', amount: threshold)
      self.turnFlags.invincible = true
      self.addStatusEffect('dodge_invincible', amount: 1)
    }
  }

  function dodge_clumsy_self_turn_end(self, opponent, effect, details) {
    final existed = self.hasStatusEffect('dodge_clumsy')
    final threshold = self.data.stats.clumsyThreshold
    if (existed >= threshold) {
      self.removeStatusEffect('dodge_clumsy', amount: threshold)
      self.turnFlags.staggering = true
      self.addStatusEffect('dodge_staggering', amount: 1)
    }
  }

  function dodge_invincible_self_taking_damage(self, opponent, effect, details) {
    details.percentageChange2 += -0.75
  }

  function dodge_invincible_opponent_turn_end(self, opponent, effect, details) {
    self.removeStatusEffect('dodge_invincible')
  }

  function dodge_staggering_self_taking_damage(self, opponent, effect, details) {
    details.percentageChange2 += 0.75
  }

  function dodge_staggering_opponent_turn_end(self, opponent, effect, details) {
    self.removeStatusEffect('dodge_staggering')
  }

  /// 护甲：回合开始时衰减。基础保留 50%，护甲保持（persistent）每层额外保留 1%，
  /// 上限 100%（50 层）；护甲保持为常驻效果，不消耗
  function defense_self_turn_start(self, opponent, effect, details) {
    let persistent = self.hasStatusEffect('persistent')
    if (persistent > 0) {
      self.turnFlags.defensePersisted = true
    }
    final amount = Math.min(persistent, 50)
    let reserved = 0.5 + amount * 0.01
    let percentage = 1 - reserved
    self.removeStatusEffect('defense', percentage: percentage)
  }

  /// 易伤：受到任何伤害时消耗，增加等量伤害（不分类型的单一状态）
  function vulnerable_self_taking_damage(self, opponent, effect, details) {
    details.baseChange += effect.amount
    self.removeStatusEffect('vulnerable')
  }

  /// 易伤：回合结束时减半
  function vulnerable_self_turn_end(self, opponent, effect, details) {
    self.removeStatusEffect('vulnerable', percentage: 0.5)
  }

  /// 幸运：使用攻击牌时消耗 1 层（按卡牌身份二选一，与是否处于转化态无关）：
  /// 元素牌（七元素，含金/土/风控制元素——其异常经同一计数器施加）→
  /// 本张卡牌必定造成异常（每满 10 点伤害 1 层）；物理伤害牌 → 本张卡牌必定暴击。
  /// 真气牌等非元素牌：不触发、不消耗（真气的内伤走自身路径，不经此判定）
  function buff_crit_self_using_card(self, opponent, effect, details) {
    if (self.cardFlags.category != 'attack') return

    if (Constants.elementAilments[self.cardFlags['elementType']] != null) {
      self.turnFlags.guaranteedAilment = true
    } else if (self.cardFlags.damageType == 'physical') {
      self.turnFlags.guaranteedCrit = true
    } else {
      return
    }
    self.removeStatusEffect(effect.id, amount: 1)
  }

  /// 辟邪：获得负面效果时，每层辟邪抵消 1 层负面效果（按层消耗）
  function buff_ward_self_gained_debuff(self, opponent, effect, details) {
    final ward = self.hasStatusEffect(effect.id)
    if (ward <= 0) return

    final canceled = Math.min(ward, details.amount)
    details.cancelAmount = (details.cancelAmount ?? 0) + canceled
    self.removeStatusEffect(effect.id, amount: canceled)
  }

  /// 护盾：每层抵挡一次任意伤害，触发时消耗
  function buff_shield_self_taking_damage(self, opponent, effect, details) {
    if (details.damageType == 'pure') return

    if (!details.cancelDamage) {
      details.cancelDamage = true
      self.removeStatusEffect(effect.id, amount: 1)
    }
  }
  // 不幸（debuff_crit）的效果在 Dart 侧 takeDamage 中结算，双效果：
  // 暴击分支：每层使本次暴击倍率 -25%（下限 100%），按层循环消耗至倍率 100% 或不幸耗尽
  // 异常分支：持有不幸的攻击方赋予元素异常时按层抵消（1 层不幸抵消 1 层异常）

  /// 邪祟：回合开始时，消耗 1 层邪祟并获得 1 层随机负面效果（从 Constants.debuffs 池抽取）
  function debuff_ward_self_turn_start(self, opponent, effect, details) {
    self.removeStatusEffect(effect.id, amount: 1)

    // 从负面效果池中随机选择一个
    final debuffs = Constants.debuffs.toList()
    debuffs.remove('debuff_ward')
    final debuffId = random.nextIterable(debuffs)
    self.addStatusEffect(debuffId, amount: 1)
  }

  /// 破绽：持有者下一次受到的任意类型伤害翻倍（含纯粹），触发时消耗 1 层
  /// 多段攻击每段各消耗 1 层
  function debuff_shield_self_taking_damage(self, opponent, effect, details) {
    final removed = self.removeStatusEffect(effect.id, amount: 1)
    if (removed > 0) {
      details.percentageChange2 += 1.0
    }
  }


  /// 流血（金）：使用攻击牌后，每层失去 5 点生命
  function ailment_bleeding_self_attacked(self, opponent, effect, details) {
    self.changeLife(-effect.amount * 5)
  }

  /// 内伤（土）：使用加持牌后，每层失去 5 点生命
  function ailment_internal_injury_self_used_card(self, opponent, effect, details) {
    if (self.cardFlags.category != 'buff') return

    self.changeLife(-effect.amount * 5)
  }

  /// 幻觉（风）：回合开始时，每层转化为 1 点缓慢，并耗尽层数
  function ailment_hallucination_self_turn_start(self, opponent, effect, details) {
    self.addStatusEffect('speed_slow', amount: 1)
    self.removeStatusEffect(effect.id)
  }

  /// 元素异常（持续伤害类）统一脚本
  /// 伤害受对应元素抗性减免（抗性净值由 getElementalResist 给出，含全元素抗性，上限 75%，允许负抗性加深），
  /// 并受施加方的元素异常伤害倍率（ailmentMultiplier）放大
  /// 点燃（火）：回合开始时耗尽所有层数，每层受到固定 5 点火焰伤害（每层单独跳字）
  /// 感电（雷）：回合开始时耗尽所有层数，每层随机受到 1~10 点雷电伤害（每层单独跳字）
  /// 冰缓（水）：回合结束时消耗 1 层，受到 1 点寒冰伤害，并转化为 1 层迟钝
  /// 中毒（木）：回合结束时受到固定 5 点毒素伤害，并移除 1 层
  /// （爆发对：火/雷回合开始耗尽；绵长对：冰/毒回合结束滴注——火烧尽、电放完，冰寒侵骨、毒素缠绵）
  /// （DOT 与其他负面效果一样，由 Dart 侧 changeLife 在治疗时统一随机驱散）
  function ailment_self_turn_start(self, opponent, effect, details) {
    final factor = 1 - 0.01 * self.getElementalResist(effect.damageType)
    final multiplier = (effect.ailmentMultiplier ?? 100) / 100
    if (effect.damageType == 'lightning') {
      for (final i in range(effect.amount)) {
        final dmg = ((random.nextInt(10) + 1) * multiplier * factor).round()
        if (dmg > 0) self.changeLife(-dmg, damageType: effect.damageType)
      }
      self.removeStatusEffect(effect.id)
    } else if (effect.damageType == 'fire') {
      for (final i in range(effect.amount)) {
        final dmg = (effect.dotDamage * multiplier * factor).round()
        if (dmg > 0) self.changeLife(-dmg, damageType: effect.damageType)
      }
      self.removeStatusEffect(effect.id)
    }
  }

  function ailment_self_turn_end(self, opponent, effect, details) {
    final factor = 1 - 0.01 * self.getElementalResist(effect.damageType)
    final multiplier = (effect.ailmentMultiplier ?? 100) / 100
    if (effect.damageType == 'ice') {
      // 每回合结束只消耗 1 层：1 点寒冰伤害并转化 1 层迟钝（绵长干扰，层数可跨回合存留）
      final dmg = (effect.dotDamage * multiplier * factor).round()
      if (dmg > 0) self.changeLife(-dmg, damageType: effect.damageType)
      self.addStatusEffect('dodge_clumsy', amount: 1)
      self.removeStatusEffect(effect.id, amount: 1)
    } else if (effect.damageType == 'poison') {
      final dmg = (effect.dotDamage * multiplier * factor).round()
      if (dmg > 0) self.changeLife(-dmg, damageType: effect.damageType)
      self.removeStatusEffect(effect.id, amount: 1)
    }
  }

  /// 正气：使用无属性或真气伤害的攻击牌时消耗 1 层，本张卡牌获得 20% 防御穿透
  // function energy_positive_penetrate_self_using_card(self, opponent, effect, details) {
  //   if (self.cardFlags.category != 'attack') return
  //   if (self.cardFlags.damageType != 'ordinary' && self.cardFlags.damageType != 'chi') return
  //   if (self.hasStatusEffect('energy_positive_penetrate') <= 0) return

  //   self.cardFlags.damage.penetration = (self.cardFlags.damage.penetration ?? 0) + 0.2
  //   self.removeStatusEffect(effect.id, amount: 1)
  // }


  /// 每点怒气使自身受到的伤害 +5%
  function energy_positive_unarmed_self_taking_damage(self, opponent, effect, details) {
    details.percentageChange1 += 0.05 * effect.amount
  }

  function energy_negative_life_self_turn_start(self, opponent, effect, details) {
    let lost = -(self.lifeMax * 0.05).ceil()
    self.changeLife(lost)

    self.removeStatusEffect(effect.id, amount: 1)
  }

  /// 无极之气：每层使造成的所有伤害 +5
  /// （普通状态而非资源气：永久保留，不参与每回合清空；与虚空之气互相抵消）
  function buff_all_damage_self_doing_damage(self, opponent, effect, details) {
    details.baseChange += effect.amount * 5
  }

  /// 虚空之气：每层使造成的所有伤害 -5（与无极之气互相抵消）
  function debuff_all_damage_self_doing_damage(self, opponent, effect, details) {
    details.baseChange -= effect.amount * 5
  }

  /// 戾气：回合结束时，若造成了伤害，消耗 1 层并失去伤害值 10% 的生命（穿透的是自身）
  // function energy_negative_penetrate_self_turn_end(self, opponent, effect, details) {
  //   if (self.turnFlags.totalDamage <= 0) return

  //   let lost = -((self.turnFlags.totalDamage / 10) * effect.amount).round()
  //   self.changeLife(lost)
    
  //   self.removeStatusEffect(effect.id, amount: 1)
  // }

  /// 劫气：回合开始时消耗 1 层，失去 10% 生命上限的生命
  function debuff_tribulation_self_turn_start(self, opponent, effect, details) {
    let lost = -(self.lifeMax * 0.1).ceil()
    self.changeLife(lost)

    self.removeStatusEffect(effect.id, amount: 1)
  }

  /// 三清法相（悟道绝世「一气化三清」授予，双方获得）：持有者造成 effect.damageType
  /// 匹配的伤害时，每层 +1%（独立乘区2，不走乘区1攻击力）；
  /// 持有者回合结束时移除——敌方的实例在其下个回合结束前持续生效，正是对称效果的代价面
  function element_amplify_self_doing_damage(self, opponent, effect, details) {
    if (details.damageType != effect.damageType) return
    details.percentageChange2 += 0.01 * effect.amount
  }

  function element_amplify_self_turn_end(self, opponent, effect, details) {
    self.removeStatusEffect(effect.id)
  }

  /// 太上忘情（悟道绝世授予）：回合结束时，每有一张手牌受到 effect.damagePerCard 点
  /// 纯粹伤害（固定值不随境界缩放）；下回合产出阶段每有一张手牌额外获得
  /// effect.resourcePerCard 层 effect.resourceId 资源（pendingResources 是 turnFlags 清空中
  /// 唯一跨回合保留的键）。触发后移除。状态脚本必须非 async，getHandCards/changeLife 均同步
  function handcards_to_mana_self_turn_end(self, opponent, effect, details) {
    final handCount = self.getHandCards().length
    if (handCount > 0) {
      self.changeLife(-effect.damagePerCard * handCount, damageType: 'pure')
      var pending = self.turnFlags['pendingResources']
      if (pending == null) {
        pending = {}
        self.turnFlags['pendingResources'] = pending
      }
      pending[effect.resourceId] =
          (pending[effect.resourceId] ?? 0) + effect.resourcePerCard * handCount
    }
    self.removeStatusEffect(effect.id)
  }

  /// 阴阳五行（悟道结丹境界节点状态）：回合结束时，未使用的灵气（effect.resourceId）
  /// 每层对对手造成 effect.damagePerStack 点随机元素伤害（火/冰/雷随机，受对方抗性减免）。
  /// 资源转化而非攻击，直接 changeLife 结算（状态脚本非阻塞，不走 async 的 takeDamage）；
  /// 资源保留（被动 energyRetain 字段，蓄灵佩等）保留到下回合的灵气不触发本结算
  function yin_yang_five_elements_self_turn_end(self, opponent, effect, details) {
    var mana = self.hasStatusEffect(effect.resourceId)
    if (mana <= 0) return
    // 扣除将被保留到下回合的部分（见 character.dart clearResourceEffects 的资源保留机制）
    for (final source in ['passives', 'ephemeralPassives']) {
      final passives = self.data[source]
      if (passives == null) continue
      for (final key in passives.keys) {
        final retain = passives[key]['energyRetain']
        if (retain == null) continue
        if (retain['resourceId'] != effect.resourceId) continue
        final retainMax = retain['max'] ?? 0
        if (retainMax > 0) mana -= Math.min(mana, retainMax)
      }
    }
    if (mana <= 0) return
    final damageTypes = ['fire', 'ice', 'lightning']
    final damageType = damageTypes[random.nextInt(damageTypes.length)]
    final factor = 1 - 0.01 * opponent.getElementalResist(damageType)
    final damage = (mana * effect.damagePerStack * factor).round()
    if (damage > 0) {
      opponent.changeLife(-damage, damageType: damageType)
    }
  }

  /// 五气朝元（悟道还婴境界节点状态）：每个回合开始时，按 御水术→御火术→土遁→御风术→雷法
  /// 的顺序轮流获得对应套路的伤害增强（increase_damage_* 永久状态，1 层 = +1%），
  /// 增强层数 = 自身灵力属性的一半；先移除上轮所授层数，再授予本轮。
  /// 轮转记录存于角色数据 elementRotation（跨回合持久；turnCount 每场战斗重置，即每场从御水术重新开始）
  function five_qi_convergence_self_turn_start(self, opponent, effect, details) {
    const kinds = ['waterbend', 'firebend', 'earthbend', 'airbend', 'lightning_control']
    final last = self.data['elementRotation']
    if (last != null) {
      self.removeStatusEffect(last['statusId'], amount: last['amount'])
      self.data['elementRotation'] = null
    }
    final amount = (self.data.stats['spirituality'] ?? 0) ~/ 2
    if (amount <= 0) return
    final kind = kinds[(self.turnCount - 1) % kinds.length]
    final statusId = 'increase_damage_${kind}'
    self.addStatusEffect(statusId, amount: amount)
    self.data['elementRotation'] = {
      'statusId': statusId,
      'amount': amount,
    }
  }

  /// 抱真守一（悟道/御剑共享分支节点状态）：使用元素牌后，手牌里随机一张相同元素牌获得升级。
  /// upgradeHandCards 的 Dart 实现体内无 await（升级、跳字、刷新均同步完成），
  /// 状态脚本不 await 调用是安全的（async 仅为签名约定，见 plan/battle_script_migration.md 2.13）
  function embrace_simplicity_self_used_card(self, opponent, effect, details) {
    final card = self.getLastUsedCard()
    if (card == null) return
    final elementType = card['affixes'][0]['elementType']
    if (elementType == null) return
    self.upgradeHandCards(1, options: { 'elementType': elementType })
  }

  /// 五行轮转（悟道/御剑共享分支节点状态）：本回合每使用一种不同的元素牌，
  /// 获得 1 层 effect.resourceId 资源（灵气）。
  /// 判定依据 turnFlags['usedElements']（Dart 侧 onUseCard 对元素牌无条件记录，
  /// 记录点早于 self_used_card 分发）：该元素计数为 1 即本回合首次使用
  function element_cycle_self_used_card(self, opponent, effect, details) {
    final card = self.getLastUsedCard()
    if (card == null) return
    final elementType = card['affixes'][0]['elementType']
    if (elementType == null) return
    final usedElements = self.turnFlags['usedElements']
    if (usedElements == null) return
    if (usedElements[elementType] == 1) {
      self.addStatusEffect(effect.resourceId, amount: 1)
    }
  }

  /// 太上感应（悟道凝气境界节点状态）：回合产出阶段，每 effect.spiritualityPer 点灵力
  /// 获得 1 层 effect.resourceId 资源（灵气）。
  /// 必须挂产出阶段时机（self_produce_resources）：更早时机（如 self_turn_start）授予的
  /// 阳气会被随后的 clearResourceEffects 当残留清空（见 character.dart produceTurnStartResources）
  function supreme_sensing_self_produce_resources(self, opponent, effect, details) {
    final spirituality = self.data.stats['spirituality'] ?? 0
    final amount = spirituality ~/ effect.spiritualityPer
    if (amount > 0) {
      self.addStatusEffect(effect.resourceId, amount: amount)
    }
  }

  /// 窥天镜（绝世装备状态）：每次观星结算后，从元素异常表（Constants.elementAilments
  /// 的值域，共 7 种）中随机抽取 2 种不重复的元素异常，对自身各施加 1 层。
  /// source 显式传自身：配合五行珠时自施异常走「造成+受到」双向放大
  function scry_self_ailments_self_scry(self, opponent, effect, details) {
    final ailmentIds = []
    for (final id in Constants.elementAilments.values) {
      ailmentIds.add(id)
    }
    final chosen = []
    while (chosen.length < 2) {
      final id = random.nextIterable(ailmentIds)
      if (!chosen.contains(id)) {
        chosen.add(id)
      }
    }
    for (final id in chosen) {
      self.addStatusEffect(id, amount: 1, source: self)
    }
  }

  /// 聚灵旗（绝世装备状态）：回合产出阶段，获得 effect.manaBonus 层悟道灵气。
  /// 必须挂产出阶段时机（self_produce_resources）：更早时机授予的灵气会被
  /// clearResourceEffects 当残留清空（同 supreme_sensing 的约束）
  function turn_start_mana_bonus_self_produce_resources(self, opponent, effect, details) {
    self.addStatusEffect('energy_positive_spell', amount: effect.manaBonus ?? 3)
  }
}