// import 'battle_character.ht'

/// ------------------------------------------------------------
/// CardScript：卡牌词条脚本命名空间
/// ------------------------------------------------------------
/// 所有词条脚本的签名统一为 (self, opponent, card, affix)：
///   self / opponent —— 出牌方 / 对方的战斗角色（BattleCharacter 外部类）
///   card  —— 卡牌数据本体（BattleCard struct），可读写其字段（如 card.isRetained）；
///            主词条经 card.affixes[0] 访问（kind / cardType / damageType 等以它为准）
///   affix —— 本词条数据（可读 value / buffId / 自定义字段）
///
/// 打出时（on-play）：
/// 每个词条的 scripts 字段是脚本函数名数组，打出时按数组顺序逐个 invoke，
/// 多个基础效果因此可以自由组合（如 scripts: ["attack", "opponent_debuff"]）。
/// 执行顺序：priority < 0 的额外词条（按 priority 降序）→ 主词条（先播放动画）
///   → 其余额外词条（按 priority 降序）。
/// Dart 侧对每个词条脚本统一 await（同步脚本的 await 是空操作）；
/// 调用了异步 BattleCharacter 方法（drawCards / scry / upgradeHandCards）的脚本
/// 必须声明 async 并 await（如 draw_cards / scry / scry_then_draw），
/// 否则该方法会脱离结算顺序异步执行。
///
/// 时机回调：
/// 词条数据声明 callbacks 列表后，会在对应时机按 scripts 数组顺序调用 {script}_{时机} 函数，签名相同。
/// 现有时机：added_to_hand（进入手牌区时）、removed_from_hand（离开手牌区时）。
/// 声明了 callbacks 的词条仍需 scripts 字段作为函数名前缀；
/// 声明的时机回调函数必须存在（缺失会抛出脚本错误并中断结算）；
/// 额外词条打出时的基名函数允许缺省（纯回调词条，如调息 attune / 保留 retain），
/// Dart 侧以 ignoreUndefined 调用，函数不存在时忽略并告警一次；主词条基名函数必须存在。
///
/// 契约详情见 docs/docs/mod/battle/card/readme.md
/// ------------------------------------------------------------
namespace CardScript {

  /// ------------------------------------------------------------
  /// 牌库操作
  /// ------------------------------------------------------------

  /// 抽牌。
  /// 数据层可在词条上附带条件子表（字段：category / genre / cardType / kind / elementType 任意组合）：
  /// filter —— 从牌库中抽取完全符合全部指定字段的卡牌；
  /// reduceCost —— 抽到的牌若完全符合全部指定字段，费用降为 0
  /// （如悟道分支授予卡「紫微斗数」：reduceCost: {} 空条件表 = 抽到的任意牌费用降为 0）
  /// async：await 抽牌完成，保证后续词条读到抽牌后的手牌
  async function draw_cards(self, opponent, card, affix) {
    await self.drawCards(affix.value[0], options: affix)
  }

  /// 观星：查看牌库顶 N 张牌（N = value[0]，缺省 3 张；不足则全显），
  /// 选一张放回牌库顶，其余进弃牌堆。牌库为空时不触发（观星不触发洗牌）。
  /// 打出时触发（含悟道专属额外词条 scry）；
  /// 天赋分支「天道推演」的免费观星在回合开始抽牌前触发（Dart 侧直接调用，不经过本函数）。
  /// async：await 观星交互完成，后续词条与结算在选牌之后继续
  async function scry(self, opponent, card, affix) {
    await self.scry(count: affix.value?[0])
  }

  /// ------------------------------------------------------------
  /// 攻击
  /// ------------------------------------------------------------

  /// 攻击
  function attack(self, opponent, card, affix) {
    opponent.takeDamage({
      isMain: true,
      kind: affix.kind,
      cardType: affix.cardType,
      damageType: affix.damageType,
      baseValue: affix.value[0],
    })
  }
  /// 多次攻击
  function attack_multiple(self, opponent, card, affix) {
    for (final i in range(affix.value[1])) {
      opponent.takeDamage({
        isMain: true,
        kind: affix.kind,
        cardType: affix.cardType,
        damageType: affix.damageType,
        baseValue: affix.value[0],
      })
    }
  }

  /// 多段攻击并在结束后施加减益（如 wind_storm 风雷破）：
  /// 段数 = value[1]，每段 value[0] 伤害；全部命中后对手获得 buffId 状态 value[2] 层
  function attack_multiple_debuff(self, opponent, card, affix) {
    for (final i in range(affix.value[1])) {
      opponent.takeDamage({
        isMain: true,
        kind: affix.kind,
        cardType: affix.cardType,
        damageType: affix.damageType,
        baseValue: affix.value[0],
      })
    }
    opponent.addStatusEffect(affix.buffId, amount: affix.value[2])
  }

  /// 多段攻击并在结束后按元素映射附加元素异常（如 wind_storm 风雷破，主词条用）：
  /// 段数 = value[1]，每段 value[0] 伤害；全部命中后对手获得
  /// Constants.elementAilments[本牌元素] 对应的元素异常 value[2] 层
  /// （不经异常计数器）
  function attack_multiple_ailment(self, opponent, card, affix) {
    for (final i in range(affix.value[1])) {
      opponent.takeDamage({
        isMain: true,
        kind: affix.kind,
        cardType: affix.cardType,
        damageType: affix.damageType,
        baseValue: affix.value[0],
      })
    }
    final ailmentId = Constants.elementAilments[affix.elementType]
    if (ailmentId == null) return
    opponent.addStatusEffect(ailmentId, amount: affix.value[2])
  }

  /// 按元素种数的多段攻击（如 chain_lightning 连环闪电）：
  /// 段数 = 本回合已使用的不同元素种数（含本牌元素），至少 1 段，每段 value[0] 伤害。
  /// 已用元素读 turnFlags['usedElements']（Map，Dart 侧在元素牌结算后无条件记录，
  /// 与五行轮转分支同款键）；本牌元素按 elementType ?? damageType 补充去重
  function attack_multiple_by_used_elements(self, opponent, card, affix) {
    final usedElements = self.turnFlags['usedElements']
    var count = 0
    if (usedElements != null) count = usedElements.keys.length
    final ownElement = affix.elementType ?? affix.damageType
    if (ownElement != null &&
        (usedElements == null || !(ownElement in usedElements.keys))) {
      count += 1
    }
    if (count < 1) count = 1
    for (final i in range(count)) {
      opponent.takeDamage({
        isMain: true,
        kind: affix.kind,
        cardType: affix.cardType,
        damageType: affix.damageType,
        baseValue: affix.value[0],
      })
    }
  }

  /// 按手牌计数的多段攻击（如 ice_storm 寒冰风暴，通用）：
  /// 段数 = 手牌中完全符合 affix.filter 条件的卡牌数（条件口径同 matchCardCriteria，
  /// 如 filter: { elementType: true } 匹配任意元素牌），每段 value[0] 伤害
  function attack_multiple_by_cards_in_hand(self, opponent, card, affix) {
    final cards = self.getHandCards(options: affix.filter)
    for (final i in range(cards.length)) {
      opponent.takeDamage({
        isMain: true,
        kind: affix.kind,
        cardType: affix.cardType,
        damageType: affix.damageType,
        baseValue: affix.value[0],
      })
    }
  }

  /// 资源门槛增伤攻击（通用，如 falling_stone 陨星术）：
  /// affix.resourceId 指定的资源气层数 ≥ affix.resourceThreshold（缺省 1）时，
  /// 本次伤害 +value[1]%（乘区1，直接写入 takeDamage 明细），随后造成 value[0] 伤害。
  /// 可选尾部：affix.value 有第 3 元素时，按元素映射（Constants.elementAilments）为对手
  /// 附加本牌元素对应元素异常 value[2] 层（不经异常计数器，必然施加，见 plan/skill_tree/spellcraft.md）
  function attack_with_energy_count_check(self, opponent, card, affix) {
    final details = {
      isMain: true,
      kind: affix.kind,
      cardType: affix.cardType,
      damageType: affix.damageType,
      baseValue: affix.value[0],
    }
    if (self.hasStatusEffect(affix.resourceId) >= (affix.resourceThreshold ?? 1)) {
      details.percentageChange1 = affix.value[1] / 100
    }
    opponent.takeDamage(details)
    // 可选尾部：value[2] 存在时按元素映射附加元素异常
    if (affix.value.length > 2) {
      final ailmentId = Constants.elementAilments[affix.elementType]
      if (ailmentId != null) {
        opponent.addStatusEffect(ailmentId, amount: affix.value[2])
      }
    }
  }

  /// 动态费用在支付阶段结算；按实际支付的本色气计算伤害，不重复扣气。
  function attack_by_paid_resource(self, opponent, card, affix) {
    final paid = self.cardFlags['paidCost']?[affix.resourceId] ?? 0
    if (paid <= 0) return
    opponent.takeDamage({
      isMain: true,
      kind: affix.kind,
      cardType: affix.cardType,
      damageType: affix.damageType,
      baseValue: paid * affix.value[0],
    })
  }

  /// 基础拳法（默认卡）：固定造成 角色境界 × 5 的伤害
  /// 数值读取角色境界而非卡牌境界，无法用 valueData 表达，故用脚本
  function attack_rank_scaled(self, opponent, card, affix) {
    opponent.takeDamage({
      isMain: true,
      kind: affix.kind,
      cardType: affix.cardType,
      damageType: affix.damageType,
      baseValue: self.data.rank * 5,
    })
  }

  /// ------------------------------------------------------------
  /// 增益 / 减益
  /// ------------------------------------------------------------

  /// 攻击附带施加增益
  function attack_buff(self, opponent, card, affix) {
    opponent.takeDamage({
      isMain: true,
      kind: affix.kind,
      cardType: affix.cardType,
      damageType: affix.damageType,
      baseValue: affix.value[0],
    })
    self.addStatusEffect(affix.buffId, amount: affix.value[1])
  }

  /// 攻击附带施加减益
  function attack_debuff(self, opponent, card, affix) {
    opponent.takeDamage({
      isMain: true,
      kind: affix.kind,
      cardType: affix.cardType,
      damageType: affix.damageType,
      baseValue: affix.value[0],
    })
    opponent.addStatusEffect(affix.buffId, amount: affix.value[1])
  }

  /// 获得速度和防御
  function speed_quick_defend(self, opponent, card, affix) {
    self.addStatusEffect('speed_quick', amount: affix.value[0])
    self.addStatusEffect('defense', amount: affix.value[1])
  }
  /// 获得闪避和防御
  function dodge_nimble_defend(self, opponent, card, affix) {
    self.addStatusEffect('dodge_nimble', amount: affix.value[0])
    self.addStatusEffect('defense', amount: affix.value[1])
  }

  /// ------------------------------------------------------------
  /// 原子函数（新增保留：单一状态、值取下标 0，供后续自由组合使用）
  /// ------------------------------------------------------------

  /// 迅捷 +value[0]
  function speed_quick(self, opponent, card, affix) {
    self.addStatusEffect('speed_quick', amount: affix.value[0])
  }
  /// 闪避 +value[0]
  function dodge_nimble(self, opponent, card, affix) {
    self.addStatusEffect('dodge_nimble', amount: affix.value[0])
  }
  /// 护甲 +value[0]
  function defend(self, opponent, card, affix) {
    self.addStatusEffect('defense', amount: affix.value[0])
  }

  /// 石盾术（悟道·stone_shield）：消耗 affix.resourceId 指定的资源气（缺省灵气），
  /// 至多消耗 value[1] 点，每点转化为 value[0] 点护甲（buffId 指定状态，缺省 defense）
  function gain_defense_by_mana(self, opponent, card, affix) {
    final resourceId = affix.resourceId ?? 'energy_positive_spell'
    final mana = self.hasStatusEffect(resourceId)
    if (mana <= 0) return
    final cap = affix.value?[1] ?? mana
    final consume = Math.min(mana, cap)
    if (consume <= 0) return
    self.removeStatusEffect(resourceId, amount: consume)
    final gain = (consume * affix.value[0]).round()
    if (gain > 0) self.addStatusEffect(affix.buffId ?? 'defense', amount: gain)
  }

  /// 提升生命上限
  function buff_lifemax(self, opponent, card, affix) {
    self.setLifeMax(self.lifeMax + affix.value[0], rejuvenate: true)
  }
  /// 降低对手生命上限
  function debuff_lifemax(self, opponent, card, affix) {
    opponent.setLifeMax(opponent.lifeMax - affix.value[0])
  }

  /// 获得生命
  function heal(self, opponent, card, affix) {
    self.changeLife(affix.value[0], isHeal: true)
  }
  /// 回复生命上限百分比的生命，可以超过上限
  function heal_lifeMax(self, opponent, card, affix) {
    final regen = (affix.value[0] / 100 * self.lifeMax).round()
    self.changeLife(regen, isHeal: true)
  }

  /// 治疗并移除自身减益（如 water_mend 甘霖术）：
  /// 回复 value[0] 生命，并整层移除 affix.debuffs 列表中的全部状态
  function heal_remove_debuffs(self, opponent, card, affix) {
    self.changeLife(affix.value[0], isHeal: true)
    for (final debuffId in affix.debuffs) {
      final amount = self.hasStatusEffect(debuffId)
      if (amount > 0) self.removeStatusEffect(debuffId, amount: amount)
    }
  }

  /// 获得增益
  function self_buff(self, opponent, card, affix) {
    self.addStatusEffect(affix.buffId, amount: affix.value[0])
  }

  /// 对手获得减益
  function opponent_debuff(self, opponent, card, affix) {
    opponent.addStatusEffect(affix.buffId, amount: affix.value[0])
  }

  /// 降低对手全部元素抗性（以弱点形式附加，与抗性互相抵消）
  function opponent_reduce_resist_all(self, opponent, card, affix) {
    for (var elementResist in ['fire', 'ice', 'lightning', 'poison']) {
      opponent.addStatusEffect('weakness_${elementResist}', amount: affix.value[0])
    }
  }

  /// 降低对手全部类型的攻击力
  function opponent_weaken_attack_all(self, opponent, card, affix) {
    for (var attackType in ['unarmed', 'weapon', 'spell', 'curse']) {
      opponent.addStatusEffect('weaken_${attackType}', amount: affix.value[0])
    }
  }

  /// ------------------------------------------------------------
  /// 资源转化
  /// ------------------------------------------------------------

  /// 归元功（绝世）：消耗自身所有元气，每点元气回复 生命上限 × 词条值% 的生命
  /// 词条值为百分数（10 × 等级）；费用恒 0，消耗走效果而非费用
  function heal_vigor_all(self, opponent, card, affix) {
    final vigor = self.hasStatusEffect('energy_positive_life')
    if (vigor <= 0) return
    self.removeStatusEffect('energy_positive_life', amount: vigor)
    final regen = (affix.value[0] / 100 * vigor * self.lifeMax).round()
    if (regen > 0) self.changeLife(regen, isHeal: true)
  }

  /// 气转换（中立主词条）：消耗自身所有元气，按 词条值% 的比例转化为目标气
  /// 词条值 100 = 1:1（四色）；50 = 1:0.5（太极，向下取整，不足 2 点元气无产出）
  /// 模板同 heal_vigor_all：消耗走效果而非费用，费用恒 0
  function convert_vigor_all(self, opponent, card, affix) {
    final vigor = self.hasStatusEffect('energy_positive_life')
    if (vigor <= 0) return
    self.removeStatusEffect('energy_positive_life', amount: vigor)
    final amount = (vigor * affix.value[0] / 100).floor()
    if (amount > 0) self.addStatusEffect(affix.buffId, amount: amount)
  }

  /// 费用返还（额外词条）：按此牌实际支付量返还全部所消耗的气
  /// 依赖 Dart 侧在支付时写入 self.cardFlags['paidCost']（键 = 状态 id，值 = 实际扣除层数）
  function refund_cost(self, opponent, card, affix) {
    final paidCost = self.cardFlags['paidCost']
    if (paidCost == null) return
    for (final statusId in paidCost.keys) {
      final amount = paidCost[statusId]
      if (amount > 0) self.addStatusEffect(statusId, amount: amount)
    }
  }

  /// ------------------------------------------------------------
  /// 绝世卡专属
  /// ------------------------------------------------------------


  /// 天机术（悟道绝世）：观星 value[0] 张（缺省 5），随后抽 1 张牌。
  /// await 保证观星选中的牌置于牌库顶后才抽牌（正好将其入手）；
  /// Dart 侧统一 await 词条脚本，观星交互期间出牌结算暂停（契约见文件头注释）
  /// affix.scryOptions 可选费用修正（{chosenCostChange, othersCostChange}）：
  /// 选中减费/未选加费，本场战斗内生效（未选牌进弃牌堆，加费洗牌后兑现）
  async function scry_then_draw(self, opponent, card, affix) {
    await self.scry(count: affix.value?[0])
    await self.drawCards(1)
  }

  /// 相生相克（悟道绝世）：对双方施加随机元素异常（affix.applyToSelf 时自身同受），
  /// 种数 = 本回合已使用的元素种数（读 turnFlags['usedElements']，至少 1 种），
  /// 每种 value[0] 层。不经异常计数器，必然施加；
  /// 种类按 Constants.elementAilments 映射表不重复抽取
  /// 对称效果、不对称收益：自异常是蓄灵诀引擎的燃料、可被水疗术清除
  function ailments_by_used_elements(self, opponent, card, affix) {
    final usedElements = self.turnFlags['usedElements']
    var count = 0
    if (usedElements != null) count = usedElements.keys.length
    if (count < 1) count = 1
    final pool = []
    for (final key in Constants.elementAilments.keys) {
      pool.add(Constants.elementAilments[key])
    }
    for (final i in range(count)) {
      if (pool.isEmpty) break
      final ailmentId = random.nextIterable(pool)
      opponent.addStatusEffect(ailmentId, amount: affix.value[0])
      if (affix.applyToSelf == true) {
        self.addStatusEffect(ailmentId, amount: affix.value[0])
      }
      pool.remove(ailmentId)
    }
  }

  /// 一气化三清（悟道绝世）：抉择水/火/雷之一（discover 临时元素卡），
  /// 使双方获得对应元素的三清法相状态（value[0]%，独立乘区2，持有者回合结束移除）。
  /// affix.discoverOptions = {hint, choices: [{key, cardId}]}；
  /// affix.elementStatusMap = {抉择key: 状态id}。敌方抉择由 Dart 侧随机完成
  async function discover_element_amplify(self, opponent, card, affix) {
    final chosen = await self.discover(options: affix.discoverOptions)
    if (chosen == null) return
    final statusId = affix.elementStatusMap[chosen]
    if (statusId == null) return
    self.addStatusEffect(statusId, amount: affix.value[0])
    opponent.addStatusEffect(statusId, amount: affix.value[0])
  }

  /// 蓄灵诀（悟道绝世）：自身每有一种元素异常（Constants.elementAilments 七种查表），
  /// 获得 value[0] 层 affix.resourceId 资源（灵气）。上限 7 种，服务万法归宗门槛
  function gain_mana_by_self_ailments(self, opponent, card, affix) {
    var count = 0
    for (final key in Constants.elementAilments.keys) {
      if (self.hasStatusEffect(Constants.elementAilments[key]) > 0) count += 1
    }
    if (count <= 0) return
    self.addStatusEffect(affix.resourceId, amount: count * affix.value[0])
  }

  /// ------------------------------------------------------------
  /// 攻击联动（额外词条）
  /// ------------------------------------------------------------

  /// 攻击后每造成10点伤害回复生命
  function by_damage_heal(self, opponent, card, affix) {
    final cardDamage = self.cardFlags.damage.total ?? 0
    if (cardDamage < 10) return
    final amount = (cardDamage / 10).floor()
    self.changeLife(affix.value[0] * amount)
  }

  /// 攻击后每造成10点伤害获得防御
  function by_damage_defend(self, opponent, card, affix) {
    final cardDamage = self.cardFlags.damage.total ?? 0
    if (cardDamage < 10) return
    final amount = (cardDamage / 10).floor()
    self.addStatusEffect('defense', amount: affix.value[0] * amount)
  }

  /// 根据属性提升伤害
  function for_attribute_increase_damage(self, opponent, card, affix) {
    final amount = self.data.stats[affix.attributeId] * 0.005
    self.cardFlags.damage.percentageChange1 += amount
  }

  /// ------------------------------------------------------------
  /// 悟道流派专属（额外词条）
  /// ------------------------------------------------------------

  /// 解析条件模板中的 'self' 占位：把条件表（含 not 反选子表）中值为
  /// 字符串 'self' 的项替换为本牌主词条（card.affixes[0]）同名字段的值，
  /// 返回新的条件表（不改动词条数据本身）。
  /// 任一 'self' 解析为 null（本牌无该字段，如非元素牌的 elementType）时返回 null，
  /// 调用方视为条件不成立，效果不触发——同元素/不同元素两类词条共用一套模板
  function _resolveCriteriaSelf(criteria, card) {
    if (criteria == null) return null
    final mainAffix = card.affixes[0]
    final resolved = {}
    for (final field in criteria.keys) {
      final value = criteria[field]
      if (field == 'not' && value != null) {
        final resolvedNon = {}
        for (final nonField in value.keys) {
          final nonValue = value[nonField]
          resolvedNon[nonField] =
              nonValue == 'self' ? mainAffix[nonField] : nonValue
        }
        resolved['not'] = resolvedNon
      } else {
        resolved[field] = value == 'self' ? mainAffix[field] : value
      }
    }
    for (final field in resolved.keys) {
      final value = resolved[field]
      if (value == null) return null
      if (field == 'not') {
        for (final nonField in value.keys) {
          if (value[nonField] == null) return null
        }
      }
    }
    return resolved
  }

  /// 调息：入手时若手牌中有其他同元素牌（filter 中的 'self' 占位解析为本牌元素），
  /// 本牌 coloredCost 第一个正值费用 -value[0]（缺省 1，不低于 0）。
  /// 本牌入手后自身必在匹配集中，数量 ≥2 才存在「其他」同系牌。
  /// 实际减费量记录在 card.costReduction（{color, amount}），离开手牌区时按记录还原；
  /// 只改 card.coloredCost 展示值，originalColoredCost 基线不动，卡面自动呈减费黄色
  function reduce_cost_by_cards_in_hand_added_to_hand(self, opponent, card, affix) {
    // 幂等：已带减费记录的卡再次入手（如洗牌后重新抽到前未正常离手）先还原再重新检测
    reduce_cost_by_cards_in_hand_removed_from_hand(self, opponent, card, affix)
    final criteria = _resolveCriteriaSelf(affix.filter, card)
    if (criteria == null) return
    final cards = self.getHandCards(options: criteria)
    if (cards.length < 2) return
    final reduce = affix.value?[0] ?? 1
    for (final key in card.coloredCost.keys) {
      if (card.coloredCost[key] is num && card.coloredCost[key] > 0) {
        final applied = Math.min(reduce, card.coloredCost[key])
        card.coloredCost[key] -= applied
        card.costReduction = { color: key, amount: applied }
        break
      }
    }
  }

  /// 调息：离开手牌区时（打出/回合结束弃置/战斗重开回库）按记录还原本牌费用
  function reduce_cost_by_cards_in_hand_removed_from_hand(self, opponent, card, affix) {
    final record = card.costReduction
    if (record == null) return
    card.coloredCost[record.color] =
        (card.coloredCost[record.color] ?? 0) + record.amount
    card.costReduction = null
  }

  /// 专注（悟道专属词条 elemental_focus）：若上一张打出的牌与本牌同元素
  /// （filter 中的 'self' 占位解析为本牌元素），本牌伤害 +value[0]%（乘区1）。
  /// 上一张牌经 matchLastUsedCard 读取 turnFlags['lastUsedCard']，限定本回合
  function increase_damage_by_last_card_used(self, opponent, card, affix) {
    final criteria = _resolveCriteriaSelf(affix.filter, card)
    if (criteria == null) return
    if (!self.matchLastUsedCard(criteria)) return
    self.cardFlags.damage.percentageChange1 += affix.value[0] / 100
  }

  /// 侵染（悟道专属词条 ailment_spread）：给对方施加 value[0] 层本牌元素对应的
  /// 元素异常（Constants.elementAilments 查表；require 限定元素牌即保证映射有值）。
  /// 直接施加，不经异常计数器，必然生效（见 plan/skill_tree/spellcraft.md）
  function ailment_spread(self, opponent, card, affix) {
    final ailmentId = Constants.elementAilments[card.affixes[0].elementType]
    if (ailmentId == null) return
    opponent.addStatusEffect(ailmentId, amount: affix.value[0])
  }

  /// 轮转（悟道专属词条 cycle_draw）：若上一张打出的牌与本牌不同元素
  /// （正选 elementType: true + 反选 not: {elementType: 'self'}），
  /// 抽 value[0] 张牌（轮转路线，与专注奖励互斥）
  /// async：await 抽牌完成，保证后续词条读到抽牌后的手牌
  async function draw_by_last_card_used(self, opponent, card, affix) {
    final criteria = _resolveCriteriaSelf(affix.filter, card)
    if (criteria == null) return
    if (!self.matchLastUsedCard(criteria)) return
    await self.drawCards(affix.value[0])
  }

  /// 灵气爆发（悟道专属词条 mana_burst）：打出时灵气（affix.resourceId）层数 ≥
  /// affix.resourceThreshold（缺省 1）时，本牌伤害 +value[0]%（乘区1）
  function increase_damage_by_energy_count(self, opponent, card, affix) {
    if (self.hasStatusEffect(affix.resourceId) >= (affix.resourceThreshold ?? 1)) {
      self.cardFlags.damage.percentageChange1 += affix.value[0] / 100
    }
  }

  /// 蓄灵（悟道专属词条 mana_battery）：下回合产出阶段额外获得 value[0] 点
  /// 灵气（affix.resourceId）。以 turnFlags['pendingResources'] 子表为跨回合标记
  /// （键 = 资源气状态 id，值 = 累加层数），回合开始清空 turnFlags 时保留，
  /// produceTurnStartResources 末尾取出授予（见 character.dart 产出阶段结算）
  function gain_resource_next_turn(self, opponent, card, affix) {
    var pending = self.turnFlags['pendingResources']
    if (pending == null) {
      pending = {}
      self.turnFlags['pendingResources'] = pending
    }
    pending[affix.resourceId] = (pending[affix.resourceId] ?? 0) + affix.value[0]
  }

  /// ------------------------------------------------------------
  /// 时机回调
  /// ------------------------------------------------------------

  /// 升级（中立额外词条）：打出后本牌等级 +1（value[0] 级，当前固定 1）。
  /// 战斗内临时升级（inBattle: true），可突破卡牌等级上限；
  /// 战斗用牌是深拷贝，临时升级不污染卡库。
  function upgrade_card(self, opponent, card, affix) {
    final levels = affix.value?[0] ?? 1
    for (final i in range(levels)) {
      upgradeCard(card, inBattle: true)
    }
  }

  /// 升级手牌（中立额外词条）：随机升级手牌中 value[0] 张符合词条条件的卡牌各 +1 级。
  /// 数据层在词条上附带条件子表（字段：category / genre / cardType / kind / elementType 任意组合），
  /// 与 draw_cards 的 filter 同口径（如流派专属词条：filter: { genre: 'spellcraft' }）。
  /// 战斗内临时升级（可突破上限，深拷贝不污染卡库）。
  /// async：await 升级完成（含提示跳字与卡面刷新）
  async function upgrade_hand_cards(self, opponent, card, affix) {
    await self.upgradeHandCards(affix.value[0], options: affix.filter)
  }

  /// 保留：入手时给卡牌添加 isRetained 标记，
  /// 回合结束清理手牌时（clearHand keepRetained）留在手牌中
  function retain_added_to_hand(self, opponent, card, affix) {
    card.isRetained = true
  }

}
