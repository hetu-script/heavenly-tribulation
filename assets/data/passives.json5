{
  /// 被动属性加成词条数据
  /// 这里的词条公用于天赋树、装备、丹药等场合
  /// 这里只保存单个技能词条，具体到装备或者天赋树技能时，可能是多个词条的组合
  /// 词条可能有 rank 境界需求，但只对装备和丹药等生效，天赋树节点无视此参数
  /// 属性词条没有 base 数值，只计算 increment * level
  /// isEquipmentMain: true 表示属于装备主词条
  /// isEquipmentExtraAffix: true 表示属于装备额外词条
  /// isToolExtraAffix: true 表示属于工具额外词条
  /// isPotionMain: true 表示属于丹药主词条
  /// isEphemeral: true 表示属于临时增益额外词条
  /// ephemeralType: {'attack', 'defense', 'attribute', 'energy'} 表示临时增益的类型，影响显示和排序

  /// 装备固定词条，解锁对应装备需求的卡牌
  /// 对于该类型武器，这些是固定有的，所以 isEquipmentExtraAffix 是 false
  equipment_sword: {
    id: "equipment_sword",
    description: "passive_equipment_sword_description",
    isEquipmentMain: true,
    kinds: ["sword"],
    priority: 4899,
  },
  equipment_sabre: {
    id: "equipment_sabre",
    description: "passive_equipment_sabre_description",
    isEquipmentMain: true,
    kinds: ["sabre"],
