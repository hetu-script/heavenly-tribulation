  // ------------额外词条·悟道流派专属------------
  // 悟道（spellcraft）流派专属词条：
  // 词条 id 用流派风味名，script 用通用函数名；资源 id、过滤条件、阈值放词条数据，
  // 其他流派后续可复用同一套脚本函数。
  // 4 条元素相关词条（attune / elemental_focus / ailment_spread / cycle_draw）均带
  // require: {elementType: true}，生成侧过滤，不落到无元素卡上成为废词条

  // 升级手牌（流派专属·悟道）：随机升级手牌中 1 张悟道卡 +1 级
  // 条件子表 filter 与 draw_cards 同口径；当前应用仅限按流派过滤且只升级 1 张（value 恒 1）
  upgrade_hand_cards_spellcraft: {
    id: "upgrade_hand_cards_spellcraft",
    uniqueId: "upgrade_hand_cards_spellcraft",
    categories: ["buff", "attack"],
    genres: ["spellcraft"],
    rank: 1,
    description: "affix_upgrade_hand_cards_spellcraft",
    keywords: ["affix_upgrade_hand_cards"],
    script: "upgrade_hand_cards",
    filter: { genre: "spellcraft" },
    valueData: [
      {
        base: 1,
        isFixed: true,
      },
    ],
    greater: {
      values: [{ mode: "add", amount: 1 }],
    },
  },
  // 调息：若手牌中有其他同元素牌，本牌费用 -1（入手时检测减费，离开手牌区时还原；
  // 数值省略，脚本缺省 -1）；filter 中的 'self' 占位由脚本解析为本牌元素
  attune: {
    id: "attune",
    uniqueId: "attune",
    categories: ["buff", "attack"],
    genres: ["spellcraft"],
    rank: 2,
    description: "affix_attune",
    script: "reduce_cost_by_cards_in_hand",
    callbacks: ["added_to_hand", "removed_from_hand"],
    filter: { elementType: "self" },
    require: { elementType: true },
    keywords: ["affix_attune"],
    greater: {
      data: { costDelta: -1 },
      description: "affix_attune_greater",
    },
  },
  // 侵染：给对方施加 {0} 层本牌元素对应的元素异常（直接施加，不经异常计数器；
  // 元素→异常映射见 Constants.elementAilments）
  ailment_spread: {
    id: "ailment_spread",
    uniqueId: "ailment_spread",
    categories: ["buff", "attack"],
    genres: ["spellcraft"],
    rank: 3,
    description: "affix_ailment_spread",
    script: "ailment_spread",
    require: { elementType: true },
    valueData: [
      {
        base: 1,
        increment: 0.1,
      },
    ],
    greater: true,
    keywords: ["affix_ailment_spread"],
  },
  for_spirituality_increase_damage: {
