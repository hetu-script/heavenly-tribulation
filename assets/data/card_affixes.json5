    script: "scry",
    valueData: [
      {
        base: 3,
        maxLevel: 0,
      },
    ],
    keywords: ["affix_scry"],
  },
  // 轮转：若上一张打出的牌与本牌不同元素，抽 {0} 张牌（正选任意元素牌 +
  // 反选 not 排除本牌元素；与专注奖励互斥）
  cycle_draw: {
    id: "cycle_draw",
    uniqueId: "cycle_draw",
    categories: ["buff"],
    genres: ["spellcraft"],
    rank: 3,
    description: "affix_cycle_draw",
