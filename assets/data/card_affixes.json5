      {
        base: 30,
        increment: 2.5,
      },
    ],
    keywords: ["affix_elemental_focus"],
  },
  // 灵气爆发：打出时灵气（resourceId）≥ resourceThreshold 层，本牌伤害 +{0}%
  // （priority<0 先于主词条；门槛 5 直接写进本地化文案）
  mana_burst: {
    id: "mana_burst",
    uniqueId: "mana_burst",
    categories: ["attack"],
    genres: ["spellcraft"],
    rank: 3,
    priority: -1,
    description: "affix_mana_burst",
    script: "increase_damage_by_energy_count",
    resourceId: "energy_positive_spell",
    resourceThreshold: 5,
    valueData: [
      {
        base: 25,
        increment: 2.0,
      },
    ],
    keywords: ["affix_mana_burst"],
  },
  // 观星（悟道流派专属）：打出时观星 value[0] 张牌
  // （查看牌库顶 N 张，选一张放回牌库顶，其余进弃牌堆；牌库为空不触发）
  scry: {
    id: "scry",
    uniqueId: "scry",
    categories: ["buff"],
