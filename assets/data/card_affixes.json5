    require: { elementType: true },
    valueData: [
      {
        base: 1,
        maxLevel: 0,
      },
    ],
    keywords: ["affix_cycle_draw"],
  },
  // 蓄灵：下回合产出阶段额外获得 {0} 点灵气（resourceId）；
  // 以 turnFlags['pendingResources'] 为跨回合标记，产出阶段统一授予
  mana_battery: {
