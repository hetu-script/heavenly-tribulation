  // 暴击充能：每造成一次物理伤害 +1，达到暴击阈值后下一次物理伤害移除全部阈值并暴击
  //（触发结算在 Dart 侧 takeDamage 中，无脚本）
  crit_charge: {
    id: "crit_charge",
    title: "status_crit_charge",
    description: "status_crit_charge_description",
    icon: "icon/status/crit.png",
  },
  // 异常充能：每造成一次元素伤害 +1（火/冰/雷/毒共享），达到异常阈值后下一次元素伤害移除全部阈值并造成异常
  //（触发结算在 Dart 侧 takeDamage 中，无脚本）
  ailment_charge: {
    id: "ailment_charge",
    title: "status_ailment_charge",
    description: "status_ailment_charge_description",
    icon: "icon/status/ailment.png",
  },

  // 所有类型的防御: 回合开始时减半，受到攻击时抵消伤害
  // 计算伤害时，防御的优先级是最高的
  // 护甲：唯一防御类型，只抵挡物理伤害（真气自带50%穿透）
  // 抵扣结算在 Dart 侧 takeDamage 乘区后进行，脚本只负责回合开始衰减
  defense: {
    id: "defense",
    title: "status_defense",
    description: "status_defense_description",
    icon: "icon/status/defense.png",
    damageType: "physical",
    script: "defense",
    priority: 1510,
    callbacks: ["self_turn_start"],
  },

  // 易伤：受到任何伤害时移除并增加等量伤害（不分类型的单一状态）
  // 回合结束时减半
  vulnerable: {
    id: "vulnerable",
    title: "status_vulnerable",
    description: "status_vulnerable_description",
    icon: "icon/status/vulnerable_physical.png",
    script: "vulnerable",
    priority: 1505,
    callbacks: ["self_taking_damage", "self_turn_end"],
  },

  // 幸运: 使用物理攻击牌时移除 1 层，使本张卡牌必定暴击（普通状态，非资源）
  buff_crit: {
    id: "buff_crit",
    title: "status_buff_crit",
    description: "status_buff_crit_description",
    icon: "icon/status/buff_crit.png",
    script: "buff_crit",
    callbacks: ["self_using_card"],
  },
  // 辟邪：获得负面效果时移除并取消该效果（普通状态，非资源）
  buff_ward: {
    id: "buff_ward",
    title: "status_buff_ward",
    description: "status_buff_ward_description",
    icon: "icon/status/buff_ward.png",
    script: "buff_ward",
    callbacks: ["self_gained_debuff"],
  },
  // 护盾：每层抵挡一次任意非纯粹伤害，触发时移除（普通状态，非资源）
  buff_shield: {
    id: "buff_shield",
    title: "status_buff_shield",
    description: "status_buff_shield_description",
    icon: "icon/status/buff_shield.png",
    script: "buff_shield",
    callbacks: ["self_taking_damage"],
  },

  // 不幸: 每层使下一次暴击的暴击倍率 -25%（在 Dart 侧暴击分支结算，无脚本）（普通状态，非资源）
  debuff_crit: {
    id: "debuff_crit",
    title: "status_debuff_crit",
    description: "status_debuff_crit_description",
    script: "debuff_crit",
    icon: "icon/status/debuff_crit.png",
    isDebuff: true,
  },
  // 邪祟：回合开始时移除并获得随机负面效果（普通状态，非资源）
  debuff_ward: {
    id: "debuff_ward",
    title: "status_debuff_ward",
    description: "status_debuff_ward_description",
    script: "debuff_ward",
    icon: "icon/status/debuff_ward.png",
    callbacks: ["self_turn_start"],
    isDebuff: true,
  },
  // 破绽：持有者下一次受到的任意类型伤害翻倍（含纯粹），触发时移除（普通状态，非资源）
  debuff_shield: {
    id: "debuff_shield",
