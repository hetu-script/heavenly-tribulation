    isDebuff: true,
    callbacks: ["self_turn_start", "self_gained_energy_positive"],
  },

  // 元素持续伤害（DOT）：统一参数化脚本 element_dot
  // dotDamage = 固定伤害数值（感电为脚本内随机 1~10）；消耗逻辑全部内联进脚本
  // 点燃：回合开始时受到固定 5 点火焰伤害，同时消耗 1 层（层数=剩余触发次数）
  element_dot_fire: {
    id: "element_dot_fire",
    title: "status_element_dot_fire",
    description: "status_element_dot_fire_description",
    icon: "icon/status/element_dot_fire.png",
    damageType: "fire",
    dotDamage: 5,
    script: "element_dot",
    isDebuff: true,
    callbacks: ["self_turn_start"],
  },
  // 感电：回合开始时耗尽所有层数，每层随机受到 1~10 点雷电伤害（每层单独跳字）
  element_dot_lightning: {
    id: "element_dot_lightning",
    title: "status_element_dot_lightning",
    description: "status_element_dot_lightning_description",
    icon: "icon/status/element_dot_lightning.png",
    damageType: "lightning",
    dotDamage: 0,
    script: "element_dot",
    isDebuff: true,
    callbacks: ["self_turn_start"],
  },
  // 冰缓：回合结束时耗尽所有层数，每层受到 1 点寒冰伤害，并分别随机转化为缓慢或迟钝
  element_dot_ice: {
    id: "element_dot_ice",
    title: "status_element_dot_ice",
    description: "status_element_dot_ice_description",
    icon: "icon/status/element_dot_ice.png",
    damageType: "ice",
    dotDamage: 1,
    script: "element_dot",
    isDebuff: true,
    callbacks: ["self_turn_end"],
  },
  // 中毒：回合结束时受到固定 5 点毒素伤害，不自动消耗；治疗时驱散 1 层（与流血同规则）
  element_dot_poison: {
    id: "element_dot_poison",
    title: "status_element_dot_poison",
    description: "status_element_dot_poison_description",
    icon: "icon/status/element_dot_poison.png",
    damageType: "poison",
    dotDamage: 5,
    script: "element_dot",
    isDebuff: true,
    callbacks: ["self_turn_end", "self_heal"],
  },

