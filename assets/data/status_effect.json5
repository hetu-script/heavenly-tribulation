{
  // 战斗状态数据，目前只保存了该状态的id、类型和触发时机
  // 所有的状态都必定有一个图标，永久状态是大图标，临时状态是小图标
  // 状态icon约定路径为: 'assets\images\icon\${id}.png'
  // isPermanent 的状态为永久状态，单独以大图标绘制在卡组上方，而非角色血条上
  // isResource 的状态为费用资源，显示在永久状态图标下方
  // isOngoing 的状态为持续状态，经过指定的回合数后自动移除
  // isUnique 代表此状态只能获得 1 个，之后再次获取会忽略
  // 当获得或失去状态时，如果存在反状态，数值会抵消

  // 所有类型的攻击增强，每有一点，造成的伤害增加 1%
  // 攻击增强是永久效果，并且可以从装备、天赋等场合获得
  // 阶段4.5：脚本退役，结算收敛进 takeDamage（乘区1 直接读取状态净值），此处仅作计数与展示
  enhance_unarmed: {
    id: "enhance_unarmed",
    title: "status_enhance_unarmed",
    description: "status_enhance_unarmed_description",
    icon: "icon/status/permanent/enhance_unarmed.png",
    cardType: "unarmed",
    isPermanent: true,
  },
  enhance_weapon: {
    id: "enhance_weapon",
    title: "status_enhance_weapon",
    description: "status_enhance_weapon_description",
    icon: "icon/status/permanent/enhance_weapon.png",
    cardType: "weapon",
    isPermanent: true,
  },
  enhance_spell: {
    id: "enhance_spell",
    title: "status_enhance_spell",
    description: "status_enhance_spell_description",
    icon: "icon/status/permanent/enhance_spell.png",
    cardType: "spell",
    isPermanent: true,
  },
  enhance_curse: {
    id: "enhance_curse",
    title: "status_enhance_curse",
    description: "status_enhance_curse_description",
    icon: "icon/status/permanent/enhance_curse.png",
    cardType: "curse",
    isPermanent: true,
  },

