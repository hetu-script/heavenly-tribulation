  // 元素持续伤害（DOT）：统一参数化脚本 element_dot
  // dotDamage = 固定伤害数值（感电为脚本内随机 1~10）；移除逻辑全部内联进脚本
  // 点燃：回合开始时受到固定 5 点火焰伤害，同时移除 1 层（层数=剩余触发次数）
  element_dot_fire: {
    id: "element_dot_fire",
    title: "status_element_dot_fire",
    description: "status_element_dot_fire_description",
    icon: "icon/status/element_dot_fire.png",
    damageType: "fire",
    dotDamage: 5,
    script: "element_dot",
    isDebuff: true,
    callbacks: ["self_turn_start"],
  },
  // 感电：回合开始时耗尽所有层数，每层随机受到 1~10 点雷电伤害（每层单独跳字）
  element_dot_lightning: {
    id: "element_dot_lightning",
    title: "status_element_dot_lightning",
    description: "status_element_dot_lightning_description",
    icon: "icon/status/element_dot_lightning.png",
    damageType: "lightning",
    dotDamage: 0,
    script: "element_dot",
    isDebuff: true,
    callbacks: ["self_turn_start"],
  },
  // 冰缓：回合结束时耗尽所有层数，每层受到 1 点寒冰伤害，并分别随机转化为缓慢或迟钝
  element_dot_ice: {
    id: "element_dot_ice",
    title: "status_element_dot_ice",
    description: "status_element_dot_ice_description",
    icon: "icon/status/element_dot_ice.png",
    damageType: "ice",
    dotDamage: 1,
    script: "element_dot",
    isDebuff: true,
    callbacks: ["self_turn_end"],
  },
  // 中毒：回合结束时受到固定 5 点毒素伤害，不自动移除；治疗时驱散 1 层（与流血同规则）
  element_dot_poison: {
    id: "element_dot_poison",
    title: "status_element_dot_poison",
    description: "status_element_dot_poison_description",
    icon: "icon/status/element_dot_poison.png",
    damageType: "poison",
    dotDamage: 5,
    script: "element_dot",
    isDebuff: true,
    callbacks: ["self_turn_end", "self_heal"],
  },

  // 元气: 无色费用池。回合开始获得 rank + 3 层，支付无色费用移除层数；
  // 回合结束每剩余 1 层回复 2% 生命上限（每层至少 1 点），下个回合开始时清空
  // 某些地方简称为 vigor
  energy_positive_life: {
    id: "energy_positive_life",
    title: "status_energy_positive_life",
    description: "status_energy_positive_life_description",
    icon: "icon/cost/qi_basic.png",
    script: "energy_positive_life",
    isResource: true,
  },
  // 灵气
  // 某些地方简称为 mana
  // 回合结束按剩余层数触发 overflowed_mana_* 天赋（结算函数 turn_end_resource_settlement）；
  // 下个回合开始时清空（统一生命周期）
  energy_positive_spell: {
    id: "energy_positive_spell",
    title: "status_energy_positive_spell",
    description: "status_energy_positive_spell_description",
    icon: "icon/cost/qi_mana.png",
    script: "energy_positive_spell",
    isResource: true,
    cardType: "spell",
    callbacks: ["self_doing_damage"],
  },
  // 剑气
  // 某些地方简称为 chakra
  // 产出 = 上回合打出的武器攻击牌数量（需 enable_chakra）；下个回合开始时清空
  energy_positive_weapon: {
    id: "energy_positive_weapon",
    title: "status_energy_positive_weapon",
    description: "status_energy_positive_weapon_description",
    icon: "icon/cost/qi_chakra.png",
    script: "energy_positive_weapon",
    isResource: true,
    cardType: "weapon",
    callbacks: ["self_doing_damage"],
  },
  // 怒气
  // 某些地方简称为 rage
  // 产出 = 上回合自身受到的伤害 ÷ 10（需 enable_rage）；下个回合开始时清空
  // 保留风险代价：每层使自身受到的伤害 +5%（对方回合同样生效）
  energy_positive_unarmed: {
    id: "energy_positive_unarmed",
    title: "status_energy_positive_unarmed",
    description: "status_energy_positive_unarmed_description",
    icon: "icon/cost/qi_rage.png",
    script: "energy_positive_unarmed",
    isResource: true,
    cardType: "unarmed",
    callbacks: ["self_doing_damage", "self_taking_damage"],
  },
  // 煞气
  // 某些地方简称为 karma
  energy_positive_curse: {
    id: "energy_positive_curse",
    title: "status_energy_positive_curse",
    description: "status_energy_positive_curse_description",
    icon: "icon/cost/qi_karma.png",
    script: "energy_positive_curse",
    isResource: true,
    cardType: "curse",
    callbacks: ["self_doing_damage"],
  },
  // 无极之气
  // 万能费用色，可支付任意有色费用
  energy_positive_ultimate: {
    id: "energy_positive_ultimate",
    title: "status_energy_positive_ultimate",
    description: "status_energy_positive_ultimate_description",
    icon: "icon/cost/qi_ultimate.png",
    script: "energy_positive_ultimate",
    isResource: true,
    callbacks: ["self_doing_damage"],
  },

  // 死气: 回合开始时失去生命
  // 元气对应的阴气，保留为资源（仅通过卡牌/效果互动施加，不再自动叠层）
  energy_negative_life: {
    id: "energy_negative_life",
    title: "status_energy_negative_life",
    description: "status_energy_negative_life_description",
    icon: "icon/status/decay.png",
    script: "energy_negative_life",
    isResource: true,
    callbacks: ["self_turn_start"],
  },
  // 逆灵之气
  // 灵气对应的阴气，保留为资源（图标运行时反色显示）
  energy_negative_spell: {
    id: "energy_negative_spell",
    title: "status_energy_negative_spell",
    description: "status_energy_negative_spell_description",
    icon: "icon/cost/qi_mana.png",
    script: "energy_negative_spell",
    isResource: true,
    cardType: "spell",
    callbacks: ["self_doing_damage"],
  },
  // 止戈之气
  // 剑气对应的阴气，保留为资源（图标运行时反色显示）
  energy_negative_weapon: {
    id: "energy_negative_weapon",
    title: "status_energy_negative_weapon",
    description: "status_energy_negative_weapon_description",
    icon: "icon/cost/qi_chakra.png",
    script: "energy_negative_weapon",
    isResource: true,
    cardType: "weapon",
    callbacks: ["self_doing_damage"],
  },
  // 非战之气
  // 怒气对应的阴气，保留为资源（图标运行时反色显示）
  energy_negative_unarmed: {
    id: "energy_negative_unarmed",
    title: "status_energy_negative_unarmed",
    description: "status_energy_negative_unarmed_description",
    icon: "icon/cost/qi_rage.png",
    script: "energy_negative_unarmed",
    isResource: true,
    cardType: "unarmed",
    callbacks: ["self_doing_damage"],
  },
  // 无心之气
  // 煞气对应的阴气，保留为资源（图标运行时反色显示）
  energy_negative_curse: {
    id: "energy_negative_curse",
    title: "status_energy_negative_curse",
    description: "status_energy_negative_curse_description",
    icon: "icon/cost/qi_karma.png",
    script: "energy_negative_curse",
    isResource: true,
    cardType: "curse",
    callbacks: ["self_doing_damage"],
  },
  // 虚无之气
  // 无极之气对应的阴气，保留为资源（图标运行时反色显示）
  energy_negative_ultimate: {
    id: "energy_negative_ultimate",
    title: "status_energy_negative_ultimate",
    description: "status_energy_negative_ultimate_description",
    icon: "icon/cost/qi_ultimate.png",
    script: "energy_negative_ultimate",
    isResource: true,
    callbacks: ["self_doing_damage"],
  },

  // 劫气：战斗拖得太久时天道降下的惩罚（软狂暴状态，非资源）
  // 回合开始时移除 1 层，失去 10% 生命上限的生命
  debuff_tribulation: {
    id: "debuff_tribulation",
    title: "status_debuff_tribulation",
    description: "status_debuff_tribulation_description",
    icon: "icon/status/debuff_tribulation.png",
    script: "debuff_tribulation",
    isDebuff: true,
    callbacks: ["self_turn_start"],
  },
}
