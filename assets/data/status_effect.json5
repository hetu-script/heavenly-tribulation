    description: "status_weaken_weapon_description",
    icon: "icon/status/permanent/weaken_weapon.png",
    cardType: "weapon",
    isPermanent: true,
  },
  weaken_spell: {
    id: "weaken_spell",
    title: "status_weaken_spell",
    description: "status_weaken_spell_description",
    icon: "icon/status/permanent/weaken_spell.png",
    cardType: "spell",
    isPermanent: true,
  },
  weaken_curse: {
    id: "weaken_curse",
    title: "status_weaken_curse",
    description: "status_weaken_curse_description",
    icon: "icon/status/permanent/weaken_curse.png",
