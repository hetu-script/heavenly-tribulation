{
  // id:
  // 不同的词条可能有相同的affixId，非null的affixId只会在一张卡牌上出现一次。
  // category:
  // 类型，分为攻击（attack），加持（buff）两种
  // genre:
  // 流派，御剑，悟道，炼魂等，如果为null表示无流派
  // 流派仅表示获得方法，使用时并无限制
  // kind:
  // kind决定了卡牌名字类型，例如剑法，咒语等等
  // 虽然并非强制，但多数时候kind和战斗动画也是对应的
  // rank:
  // 使用卡牌需要符合境界要求
  // 境界影响卡牌的额外词条数量和种类以及卡牌等级上限
  // chance:
  // 词条出现的几率，如果 roll 值大于几率，会重新选择词条
  // cardType:
  // 卡牌类型，一共五种，徒手，武器，法术，咒语，神通
  // damageType:
  // 伤害和防御类型，一共五种，物理，真气，元素，精神，纯粹
  // elementType: null,
  // 元素类型，只有悟道流法术拥有元素类型，会和某些天赋、道具、卡牌产生互动。
  // image:卡牌插画
  // animation.startup 前摇动画
  // animation.recovery 后摇动画（可选）
  // animation.actions 过渡动画组（可选）
  // animation.overlays 叠加动画（爆炸效果等，可选）
  // animation.sound 动画播放时的声音效果
  // script: 调用的脚本函数的id
  // equipment: 装备需求
  // valueData:
  // 实际的数值会在游戏中实际创建时才添加到这里
  // 主词条等级始终和卡牌等级一致
  // level: 0,
  // value: [0]
  // 实际值=base+level*increment
  // 每个值可能有自己的maxLevel
  // isUnique:
  // 绝世卡牌，属性列表固定，但数值在范围内随机。
  // isExalted:
  // 圣化效果（只有化神卡牌可以圣化，圣化只能进行一次）：
  // 1, 获得一个可以突破数量限制的额外词条，词条是圣化专属列表中随机获得。
  // 2, 卡牌的词条等级上限提升20%
  // 3, 卡牌额外词条数量增加1
  // 4, 没有效果。
  // isUnpackable:
  // 不会出现在卡包中

  blank_default: {
    id: "blank_default",
    description: "blank_default_description",
    image: "battlecard/illustration/blank_default.png",
    isUnpackable: true,
  },

