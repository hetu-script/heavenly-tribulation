  // 归元功：消耗所有元气治疗（永远 0 费、最低 rank1 的特例卡，见 plan/battle_resource_rework.md）
  // 每点元气回复 生命上限 × 词条值% 的生命（词条值为百分数 = 10 × 等级；插画临时复用中立治疗卡）
  heal_vigor_all: {
    id: "heal_vigor_all",
    category: "buff",
    kind: "xinfa",
    cardType: "xinfa",
    rank: 1,
    isUnique: true,
    description: "affix_heal_vigor_all",
    image: "battlecard/illustration/xinfa_heal.png",
