{
  // id:
  // uniqueIds
  // 非null的词条的uniqueId只会在一张卡牌上出现一次。不会和主词条已有的,uniqueIds列表重复
  // uniqueId
  // 只有绝世卡牌有单独的uniqueId，这决定了卡牌
  // category:
  // 类别，分为攻击（attack），加持（buff）两种
  // genre:
  // 流派，御剑，悟道，炼魂等，如果为null表示无流派
  // 流派仅表示获得方法，使用时并无限制
  // cardType:
  // 卡牌类型，一共七种，徒手，武器，法术，咒语，身法，心法，神通(divinity)
  // kind:
  // kind决定了卡牌名字类型，例如剑法，咒语等等
  // 虽然并非强制，但多数时候kind和战斗动画也是对应的
  // rank:
  // 使用卡牌需要符合境界要求
  // 境界影响卡牌的额外词条数量和种类以及卡牌等级上限
  // damageType:
  // 伤害类型，一共八种，物理，真气，精神，冰，火，雷，毒，纯粹
  // elementType: null,
  // 元素类型，只有悟道流法术拥有元素类型，会和某些天赋、道具、卡牌产生互动。
  // 元素类型包含七种：金，木，水，火，土，风，雷
  // buffId: null,
  // 增益或减益的ID，对应status_effect.jon5中的数据id
  // image:卡牌插画
  // animation.startup 前摇动画
  // animation.recovery 后摇动画（可选）
  // animation.actions 过渡动画组（可选）
  // animation.overlays 叠加动画（爆炸效果等，可选）
  // animation.sound 动画播放时的声音效果
  // script: 调用的脚本函数的id
  // 费用（单资源模型，详见 plan/battle_resource_rework.md）：
  // 每张卡只花一种资源——流派卡 = rank 点流派色（悟道spell/御剑weapon/锻体unarmed/炼魂curse），
  // 中立卡（无流派，含法身avatar）= rank+1 点元气（life）。
  // 所有卡必须在数据中显式写 coloredCost（含 life 键），代码不再自动推导（仅有兜底）：
  // 标准公式——流派色 {base: 0, rankIncrement: 1}（= rank）；元气 {base: 1, rankIncrement: 1}（= rank+1）；
  // 条目也可以是固定数值（特例）；显式 life: 0 表示永远 0 费（免费卡）。
  // 多色/混费卡不禁止（未来设计），校验只给软警告
  // equipment: 装备需求
  // valueData:
  // 实际的数值会在游戏中实际创建时才添加到这里
  // 主词条等级始终和卡牌等级一致
  // level: 0,
  // value: [0]
  // 实际值=base+level*increment
  // 每个值可能有自己的maxLevel
  // isExalted:（未实现，暂缓——目前仅是设计构想，无任何代码实现）
  // 圣化效果（只有化神卡牌可以圣化，圣化只能进行一次）：
  // 1, 获得一个可以突破数量限制的额外词条，词条是圣化专属列表中随机获得。
  // 2, 卡牌的词条等级全部提升20%
  // 3, 卡牌费用变成3点无色
  // isUnpackable:
  // 不会出现在卡包中
  // isEphemeral:（可选）
  // 消耗：打出后碎裂，移出本场战斗
  // isUnique:
  // 绝世卡牌，属性列表固定，但数值在范围内随机。
  // 绝世卡牌只能在卡组中放入一张
  // 绝世卡牌的名字固定（不按 kind 随机生成）：以 uniquecard_{主词条id} 为键，
  // 保存在 assets/locale/zh/rpg/battlecard.json 中；新增绝世卡牌时必须同步添加该键，

  // 占位卡：什么都不做（木人/练习模式填充卡组用，木人没有攻击动画）
  placeholder: {
    id: "placeholder",
    coloredCost: { life: 0 },
    description: "placeholder_description",
    image: "battlecard/illustration/blank_default.png",
    isUnpackable: true,
  },

  // 默认卡：战斗开始后，不满足使用需求的卡牌（含次数耗尽的符箓）会被此牌替代
  // 效果为基础拳法：固定造成 角色境界 × 5 的伤害（脚本 attack_rank_scaled 读取角色境界）
  blank_default: {
    id: "blank_default",
    coloredCost: { life: 0 },
    category: "attack",
    kind: "punch",
    cardType: "unarmed",
    damageType: "physical",
    description: "blank_default_description",
    image: "battlecard/illustration/punch_attack.png",
    script: "attack_rank_scaled",
    isUnpackable: true,
  },

